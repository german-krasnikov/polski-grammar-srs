        { "name": "noun", "category": "noun", "requiredFeatures": ["Number", "Case"] }
      ]
    },
    "core.number": {
      "slots": [
        { "name": "owner", "category": "possessive", "optional": true, "requiredFeatures": ["Number", "Gender", "Case"], "agreementSource": "noun" },
        { "name": "adjective", "category": "adjective", "requiredFeatures": ["Number", "Gender", "Case"], "agreementSource": "noun" },
