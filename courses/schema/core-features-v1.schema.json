{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core features v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "features"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "$comment": { "type": "string" },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/feature" },
      "propertyNames": { "pattern": "^[A-Z][A-Za-z]*$" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gloss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ru": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
