{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polski frequency top 1000 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "license", "corpus", "items"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "corpus": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array", "minItems": 1000, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rank", "lemma", "count"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "lemma": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
