{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target-language curriculum v1",
  "description": "UniversalCorePlan.md §3.1/§3.2, §12 UC-06: lang/<code>/curriculum.json — the SkillSpec list a target language drills, derived from ExerciseFactory.kt's when(skillId) branches. Native-language packs do not have this file.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/skillSpec" },
  "$defs": {
    "featureKey": {
      "type": "string",
      "minLength": 1
    },
    "featureValue": {
      "type": "string",
      "minLength": 1
    },
    "featureFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "from", "to"],
      "properties": {
        "feature": { "$ref": "#/$defs/featureKey" },
        "from": { "$ref": "#/$defs/featureValue" },
        "to": { "$ref": "#/$defs/featureValue" }
      }
    },
    "featureBundle": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/featureValue" }
    },
    "lexicalFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "where"],
      "properties": {
        "slot": { "type": "string", "minLength": 1 },
        "where": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "skillSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "construction", "focus", "fixed", "lexicalFilter", "level", "prerequisites"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "construction": { "type": "string", "pattern": "^core\\." },
        "focus": {
          "oneOf": [
            { "$ref": "#/$defs/featureFocus" },
            { "type": "null" }
          ]
        },
        "fixed": { "$ref": "#/$defs/featureBundle" },
        "lexicalFilter": {
          "oneOf": [
            { "$ref": "#/$defs/lexicalFilter" },
            { "type": "null" }
          ]
        },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
