{
  "methodology": {
    "tool": ".tmp-ux5/tabs-jank.mjs (Playwright + CDP Emulation.setCPUThrottlingRate; per-transition frame deltas via a persistent requestAnimationFrame loop, long tasks via PerformanceObserver({entryTypes:['longtask']}))",
