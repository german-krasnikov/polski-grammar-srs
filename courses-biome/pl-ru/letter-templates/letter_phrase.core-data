  verificationStatus: inferred
}
LETTER_PHRASE {
  phraseId: formal-email-opening-3
  sectionRef: formal-email-opening
  targetText: "W nawiązaniu do wiadomości z dnia 5 listopada…"
  nativeNote: "«В связи с сообщением от 5 ноября…»"
  register: formal
  verificationStatus: inferred
}
LETTER_PHRASE {
  phraseId: formal-email-opening-4
  sectionRef: formal-email-opening
  targetText: "Dziękuję za szybką odpowiedź na moją poprzednią wiadomość."
  nativeNote: "«Спасибо за быстрый ответ на моё предыдущее письмо»."
  register: formal
  verificationStatus: inferred
}
LETTER_PHRASE {
  phraseId: formal-email-body-1
  sectionRef: formal-email-body
  targetText: "Niestety, w wyznaczonym terminie nie mogę przyjść na egzamin, ponieważ…"
  nativeNote: "«К сожалению, в назначенный день я не могу прийти на экзамен, потому что…»"
  register: formal
  isPreferred: true
  verificationStatus: inferred
}
