# pl-course skills — converted from course.json
# Source SHA-256: 7255e8c686ceee17a72d280e5876b0cf6776dd9a1743884cd75c724fb8180dcc
# 16 skills. Read-only historical input; this file is the new authority.
SURFACE courseSkills
SKILL {id: "case.acc.n" title: "Biernik · средний род" group: "Przypadki" level: "A1" formula: "Средний род: Biernik = Mianownik" theory: "В единственном числе средний род сохраняет базовую форму в Bierniku: widzę moje małe dziecko." hint: "moje nowe okno → widzę moje nowe okno" prerequisites: [] focus: {before: "moje duże morze" after: "moje duże morze"} methods: {logic: {introduction: "В единственном числе средний род сохраняет базовую форму в Bierniku: widzę moje małe dziecko." promptLead: "Сначала определи правило и форму." introduce: "Проверь, совпадает ли базовая форма среднего рода с формой прямого дополнения." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты показываешь собеседнику то, о чём идёт речь. Назови это целой фразой: в этой группе форма остаётся прежней." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты сообщаешь собеседнику, что видишь названное. Как сказать об этом целой фразой?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Вижу моё старое окно." target: "Widzę moje stare okno." note: "Средний род в винительном падеже не меняется ни в русском, ни в польском: «окно» и okno остаются в исходной форме." matches: true}] examples: ["Mam nowe okno." "Widzę małe dziecko."] why: "Средний род — самый простой случай: винительный падеж внешне совпадает с именительным, потому что у среднего рода в обоих языках нет отдельного окончания для этой роли."}}
SKILL {id: "case.acc.f" title: "Biernik · żeński" group: "Przypadki" level: "A1" formula: "-a → -ę; прилагательное -a → -ą" theory: "Прямой объект после widzę, mam, lubię, kupuję обычно стоит в Bierniku." hint: "Widzę kogo? co?" prerequisites: [] focus: {before: "moja młoda siostra" after: "moją młodą siostrę"} methods: {logic: {introduction: "Прямой объект после widzę, mam, lubię, kupuję обычно стоит в Bierniku." promptLead: "Сначала определи правило и форму." introduce: "Определи род и падеж группы после действия, затем проверь согласование." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты говоришь собеседнику, кого или что видишь. Представь эту сцену, затем измени окончания всей группы." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты сообщаешь, кого или что видишь. Как назвать объект целой фразой?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Вижу мою хорошую жену." target: "Widzę moją dobrą żonę." note: "В обоих языках женский род на -a/-а получает окончание -ę/-у в винительном: żona→żonę, жена→жену; прилагательное меняется вместе с существительным." matches: true}] examples: ["Mam nową książkę." "Lubię moją siostrę."] why: "Прямой объект после глаголов действия (widzę, mam, lubię) обычно стоит в винительном; у женского рода на -a это всегда -ę, как и в русском -а→-у."}}
SKILL {id: "case.acc.m" title: "Biernik · męski" group: "Przypadki" level: "A2" formula: "на согласную: живое = Gen; неживое = Nom" theory: "Для мужских существительных на согласную: widzę męża/psa, но widzę dom/samochód. У существительных на -a: widzę kolegę, но nie widzę kolegi." hint: "Сначала определи: żywotny или nieżywotny." prerequisites: ["case.acc.f"] focus: {before: "mój stary sąsiad" after: "mojego starego sąsiada"} methods: {logic: {introduction: "Для мужских существительных на согласную: widzę męża/psa, но widzę dom/samochód. У существительных на -a: widzę kolegę, но nie widzę kolegi." promptLead: "Сначала определи правило и форму." introduce: "Определи, обозначает ли мужское слово лицо, живое существо или предмет." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты рассказываешь, кого или что видишь. Смысл «вижу кого/что?» помогает выбрать форму всей группы." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты рассказываешь, кого или что видишь. Что важно в значении названного?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Вижу мужа." target: "Widzę męża." note: "Одушевлённые существительные мужского рода в винительном совпадают с родительным — это работает одинаково в русском и польском." matches: true} {native: "Вижу дом." target: "Widzę dom." note: "Неодушевлённые существительные мужского рода в винительном совпадают с именительным — тоже как в русском." matches: true}] examples: ["Widzę psa." "Widzę samochód."] why: "Мужской род различает живое и неживое в винительном падеже — это не польская особенность, а общее славянское правило, знакомое из русского."}}
SKILL {id: "case.gen.neg" title: "Dopełniacz · negacja" group: "Przypadki" level: "A2" formula: "Mam X → Nie mam + GEN" theory: "При отрицании прямого объекта Biernik очень часто превращается в Dopełniacz." hint: "Не меняй только nie — поменяй весь noun phrase." prerequisites: ["case.acc.f"] focus: {before: "Widzę moją młodą siostrę." after: "Nie widzę mojej młodej siostry."} methods: {logic: {introduction: "При отрицании прямого объекта Biernik очень часто превращается в Dopełniacz." promptLead: "Сначала определи правило и форму." introduce: "Проверь, как отрицание влияет на падеж прямого дополнения." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты отрицаешь действие с прямым объектом. В польском при отрицании меняется форма всей группы после глагола." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты отрицаешь действие, сохраняя то, о чём идёт речь. Как сказать это целым предложением?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Не вижу жену." target: "Nie widzę żony." note: "В русском при отрицании падеж не меняется (живы оба варианта — «жену»/«жены»); в польском после nie обязателен Dopełniacz." matches: false} {native: "Не вижу книгу." target: "Nie widzę książki." note: "Тот же сдвиг у неодушевлённого объекта — родительный обязателен без вариантов." matches: false}] examples: ["Nie mam czasu." "Nie widzę żadnego problemu."] why: "В польском отрицание всегда переводит прямое дополнение в родительный падеж; в русском это необязательно и звучит скорее книжно."}}
SKILL {id: "case.inst" title: "Narzędnik · z / być" group: "Przypadki" level: "A1" formula: "z + kim? czym? → INST" theory: "После z в значении «с кем/чем» используем Narzędnik. Также: Jestem programistą." hint: "z moją żoną, z dobrym kolegą" prerequisites: [] focus: {before: "moja żona" after: "z moją żoną"} methods: {logic: {introduction: "После z в значении «с кем/чем» используем Narzędnik. Также: Jestem programistą." promptLead: "Сначала определи правило и форму." introduce: "Определи падеж после предлога со значением совместного действия." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты рассказываешь, с кем идёшь. После z в значении «с кем?» меняется вся группа." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты говоришь, с кем идёшь. Как назвать спутника целой фразой?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Иду с женой." target: "Idę z żoną." note: "После «с»/z в значении совместности оба языка требуют творительного падежа." matches: true} {native: "Я программист." target: "Jestem programistą." note: "В польском профессия при być всегда в творительном; в разговорном русском связку «быть» обычно пропускают и говорят в именительном («Я программист»), творительный нужен только с «являюсь»." matches: false}] examples: ["Rozmawiam z kolegą." "Jestem nauczycielem."] why: "Творительный после z/с — обычное дело в обоих языках; а вот профессия при глаголе «быть» — разные привычки: поляки всегда используют творительный, русские обычно говорят в именительном без связки."}}
SKILL {id: "case.loc" title: "Miejscownik · o" group: "Przypadki" level: "A2" formula: "o + kim? czym? → LOC" theory: "После o (о ком/о чём) нужен Miejscownik." hint: "mówię o żonie / domu" prerequisites: ["case.inst"] focus: {before: "moja żona" after: "o mojej żonie"} methods: {logic: {introduction: "После o (о ком/о чём) нужен Miejscownik." promptLead: "Сначала определи правило и форму." introduce: "Определи падеж после предлога, который вводит тему разговора." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты рассказываешь о человеке или предмете из предложения. После o в значении «о ком/о чём?» нужна другая форма." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты рассказываешь о том, кто или что уже названо. Как обозначить тему разговора?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Говорю о жене." target: "Mówię o żonie." note: "После «о» оба языка используют падеж, обозначающий тему разговора (в русском предложный, в польском Miejscownik) — сама логика конструкции совпадает." matches: true}] examples: ["Myślę o tobie." "Czytam o historii."] why: "Предлог о/o вводит тему и требует особого падежа — в русском предложный, в польском Miejscownik; окончания разные, но роль в предложении одна и та же."}}
SKILL {id: "case.dat" title: "Celownik · komu?" group: "Przypadki" level: "A2" formula: "daję/pomagam + DAT" theory: "Celownik отвечает «кому? чему?». Учим через короткие устойчивые конструкции." hint: "Daję prezent komu?" prerequisites: [] focus: {before: "moja żona" after: "mojej żonie"} methods: {logic: {introduction: "Celownik отвечает «кому? чему?». Учим через короткие устойчивые конструкции." promptLead: "Сначала определи правило и форму." introduce: "Определи падеж получателя действия." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты передаёшь подарок человеку из предложения. Получатель действия отвечает на вопрос «кому?»." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты говоришь, кому передаёшь что-то. Как назвать получателя?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Даю жене подарок." target: "Daję żonie prezent." note: "Дательный падеж получателя действия — совпадает в обоих языках." matches: true} {native: "Помогаю жене." target: "Pomagam żonie." note: "Глагол «помогать»/pomagać управляет дательным падежом в обоих языках." matches: true}] examples: ["Mówię ci prawdę." "Dziękuję nauczycielowi."] why: "Celownik/дательный отвечает на «кому?» и работает одинаково с глаголами давания и помощи в обоих языках."}}
SKILL {id: "agreement.my" title: "Мой, твой, его, наш, их" group: "Zgoda" level: "A2" formula: "Владелец + прилагательное + существительное" theory: "mój, twój, nasz, wasz согласуются с существительным. jego, jej, ich не склоняются." hint: "moją piękną żonę → ich piękną żonę" prerequisites: ["case.acc.f" "case.gen.neg"] focus: {before: "mojej pięknej żony" after: "ich pięknej żony"} methods: {logic: {introduction: "mój, twój, nasz, wasz согласуются с существительным. jego, jej, ich не склоняются." promptLead: "Сначала определи правило и форму." introduce: "Отдели владельца от падежа группы: какие слова должны согласоваться?" retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Теперь названное принадлежит другому владельцу. Как сохранить смысл фразы?" promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Теперь названное принадлежит другому владельцу. Как сохранить смысл фразы?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Вижу его жену." target: "Widzę jego żonę." note: "«его» и jego не склоняются в обоих языках — это готовая форма для любого падежа и рода." matches: true} {native: "Вижу мою жену." target: "Widzę moją żonę." note: "«моя»/moja склоняется по роду и падежу существительного одинаково в обоих языках." matches: true}] examples: ["To jest jej dom." "Widzę ich dzieci."] why: "jego/jej/ich (его/её/их) не склоняются, потому что это застывшие формы местоимения — точно как в русском; а mój/twój/nasz/wasz согласуются с существительным, как «мой/твой/наш/ваш»."}}
SKILL {id: "verb.present" title: "Czas teraźniejszy" group: "Czasownik" level: "A1" formula: "лицо × число → окончание" theory: "Автоматизируем 6 лиц на высокочастотных глаголах." hint: "ja/ty/on/my/wy/oni" prerequisites: [] focus: {before: "robić" after: "robię"} methods: {logic: {introduction: "Автоматизируем 6 лиц на высокочастотных глаголах." promptLead: "Сначала определи правило и форму." introduce: "Определи лицо и число действующего лица для настоящего времени." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты описываешь действие прямо сейчас. Сначала назови, кто действует, затем выбери форму глагола." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты говоришь, что кто-то делает сейчас. Как назвать действие этого участника?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Он идёт." target: "On idzie." note: "В настоящем времени оба языка спрягают глагол по лицу и числу: 3-е лицо единственного числа — идёт/idzie, окончание показывает лицо одинаково в обоих языках." matches: true}] examples: ["Idzie do szkoły." "Idą do pracy."] why: "Формы настоящего времени различаются по лицу в обоих языках, но польский чаще опускает местоимение — окончание глагола само называет действующее лицо."}}
SKILL {id: "verb.past" title: "Czas przeszły" group: "Czasownik" level: "A2" formula: "основа прошедшего + род + лицо" theory: "В прошедшем времени форма отражает род говорящего/подлежащего и лицо." hint: "robił-em, robiła-m, robili-śmy" prerequisites: ["verb.present"] focus: {before: "robię" after: "robiłem"} methods: {logic: {introduction: "В прошедшем времени форма отражает род говорящего/подлежащего и лицо." promptLead: "Сначала определи правило и форму." introduce: "Определи лицо, число и род для прошедшего времени." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты рассказываешь о действии, которое уже произошло. Как назвать его?" promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты рассказываешь о действии, которое уже произошло. Как назвать его?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Она шла." target: "Szła." note: "Прошедшее время согласуется с родом подлежащего в обоих языках — «шла» и szła оба показывают женский род." matches: true} {native: "Он шёл." target: "Szedł." note: "Мужской род прошедшего времени тоже совпадает — «шёл» и szedł; лицо (он) в обоих языках выражено отдельным словом, сам глагол лица не называет." matches: true}] examples: ["Szedł do pracy." "Szła do szkoły."] why: "Прошедшее время в обоих языках зависит от рода — это общая славянская черта; а вот лицо (я/ты/он) в польском показывает сам глагол, а в русском — только отдельное местоимение."}}
SKILL {id: "verb.future" title: "Czas przyszły" group: "Czasownik" level: "A2" formula: "będę + инфинитив (несов.) / форма настоящего (сов.)" theory: "Для несовершенного вида: będę robić. Совершенный вид имеет простое будущее: zrobię." hint: "będę czytać / kupię" prerequisites: ["verb.present"] focus: {before: "robię" after: "będę robić"} methods: {logic: {introduction: "Для несовершенного вида: będę robić. Совершенный вид имеет простое будущее: zrobię." promptLead: "Сначала определи правило и форму." introduce: "Определи лицо и число для будущего времени действия." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты говоришь о действии, которое ещё произойдёт. Как назвать его для этого участника?" promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты говоришь о действии, которое ещё произойдёт. Как назвать его для этого участника?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Буду идти." target: "Będę iść." note: "Общая модель будущего несовершенного вида: буду/będę + инфинитив — сохраняется независимо от лица." matches: true} {native: "Он будет идти." target: "On będzie iść." note: "Именно эту модель тренирует упражнение: 3-е лицо, будущее несовершенного вида — będzie + iść." matches: true}] examples: ["Będziesz iść." "Będziemy iść."] why: "У будущего времени в обоих языках два способа: составное для незавершённого действия (буду/będę + инфинитив) и простая форма для завершённого результата (сделаю/zrobię) — структура полностью совпадает."}}
SKILL {id: "aspect" title: "Aspekt · robić/zrobić" group: "Czasownik" level: "B1" formula: "процесс/повторение ↔ завершённый результат" theory: "Недоконанный вид описывает процесс/повторяемость, dokonany — завершённый результат." hint: "robiłem vs zrobiłem" prerequisites: ["verb.past" "verb.future"] focus: {before: "robiłem" after: "zrobiłem"} methods: {logic: {introduction: "Недоконанный вид описывает процесс/повторяемость, dokonany — завершённый результат." promptLead: "Сначала определи правило и форму." introduce: "Сравни значение процесса и завершённого результата." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты описываешь не сам процесс покупки, а готовый результат. Выбери завершённое действие." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты хочешь подчеркнуть, что действие завершилось. Как это передать?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Я делал (не закончил)." target: "Robiłem." note: "Несовершенный вид описывает процесс без гарантии завершения — одинаково в обоих языках." matches: true} {native: "Я сделал (готово)." target: "Zrobiłem." note: "Совершенный вид подчёркивает завершённый результат — то же противопоставление, что в русской паре «сделал» против «делал»." matches: true}] examples: ["Czytałem książkę." "Przeczytałem książkę."] why: "Пара несовершенный/совершенный вид (robić/zrobić) — это то же противопоставление процесса и результата, что в русской паре делать/сделать; понятие переносится почти без изменений."}}
SKILL {id: "pronouns" title: "Zaimki osobowe" group: "Zaimki" level: "A2" formula: "ona → ją / jej / nią / niej" theory: "Тренируем местоимение сразу внутри конструкции, а не как отдельную таблицу." hint: "widzę ją; mówię o niej; idę z nią" prerequisites: ["case.inst" "case.loc"] focus: {before: "moja żona" after: "ją"} methods: {logic: {introduction: "Тренируем местоимение сразу внутри конструкции, а не как отдельную таблицу." promptLead: "Сначала определи правило и форму." introduce: "Определи падеж короткого слова, заменяющего названную группу." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Собеседник уже знает, о ком речь. Замени длинное название человека коротким местоимением." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Собеседник уже знает, о ком или о чём речь. Как избежать повторения длинной группы?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Знаю её." target: "Znam ją." note: "Личное местоимение склоняется по падежу в обоих языках, хотя конкретные формы разные." matches: true} {native: "Говорю о ней." target: "Mówię o niej." note: "После предлога оба языка добавляют дополнительный звук к местоимению: русское «н-» (о ней, с ней) и польское «ni-» (o niej, z nią) появляются в одной и той же позиции." matches: true}] examples: ["Idę z nią." "Pomagam mu."] why: "Местоимения склоняются по падежу в обоих языках; в косвенных падежах после предлогов и русский, и польский вставляют один и тот же дополнительный звук (н-/ni-) — это не совпадение, а общее наследие."}}
SKILL {id: "mixed" title: "Смешанные трансформации" group: "B1 Core" level: "B1" formula: "Лицо + время + отрицание + падеж" theory: "Смешанные карточки проверяют, можешь ли ты объединить правила в живом предложении." hint: "Сначала структура, затем окончания." prerequisites: ["agreement.my" "verb.past"] focus: {before: "Widzę moją piękną żonę." after: "Nie widziałem mojej pięknej żony."} methods: {logic: {introduction: "Смешанные карточки проверяют, можешь ли ты объединить правила в живом предложении." promptLead: "Сначала определи правило и форму." introduce: "Проверь время, отрицание и падеж как три независимых условия." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты сообщаешь, что в прошлом не увидел названное. Как удержать все условия?" promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты сообщаешь, что в прошлом не увидел названное. Как удержать все условия?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Ты не видел мою жену." target: "Nie widziałeś mojej żony." note: "В русском отрицание не всегда меняет падеж — винительный «жену» тоже допустим (родительный «жены» звучит книжнее); в польском после nie родительный обязателен всегда, без вариантов." matches: false}] examples: ["Nie robiłem tego wczoraj." "Nie widziałem jej domu."] why: "Смешанное задание складывает несколько правил сразу: время, отрицание и падеж работают как отдельные, независимые условия — проверяй их по одному, а не все сразу."}}
SKILL {id: "sentence.question" title: "Вопрос с Czy" group: "Предложение" level: "A1" formula: "Czy + утверждение → вопрос" theory: "В общем вопросе czy ставится перед предложением. Падежи при этом не меняются." hint: "Widzisz… → Czy widzisz…?" prerequisites: [] focus: {before: "Widzisz moją żonę." after: "Czy widzisz moją żonę?"} methods: {logic: {introduction: "В общем вопросе czy ставится перед предложением. Падежи при этом не меняются." promptLead: "Сначала определи правило и форму." introduce: "Определи, как превратить утверждение в общий вопрос без смены падежа." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Ты хочешь уточнить, видит ли собеседник названное. Как задать общий вопрос?" promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Ты хочешь уточнить, видит ли собеседник названное. Как задать общий вопрос?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Ты видишь мою жену?" target: "Czy widzisz moją żonę?" note: "В русском общий вопрос обычно образуется только интонацией (падежи и порядок слов не меняются); в польском для этого есть отдельное слово czy в начале предложения." matches: false}] examples: ["Czy masz czas?" "Czy on tu jest?"] why: "В русском вопрос без вопросительного слова опирается на интонацию (изредка — книжную частицу «ли» после глагола); в польском для этого есть отдельное слово czy, которое всегда ставится в начале предложения."}}
SKILL {id: "sentence.plural" title: "Единственное → множественное" group: "Предложение" level: "A2" formula: "Местоимение + прилагательное + существительное → множественное число" theory: "Во множественном числе различай мужскую личную группу и все остальные." hint: "mojego kolegę → moich kolegów; moją książkę → moje książki" prerequisites: ["case.acc.m" "agreement.my"] focus: {before: "mojego kolegę" after: "moich kolegów"} methods: {logic: {introduction: "Во множественном числе различай мужскую личную группу и все остальные." promptLead: "Сначала определи правило и форму." introduce: "Определи число и тип группы перед изменением формы." retrieve: "Определи признаки и преобразуй исходное предложение самостоятельно." feedback: "Сравни исходную и новую форму, затем проверь каждое изменение и правило." review: "Выбери «Повторить» или «Вспомнил» по своей попытке; затем реши новое задание без подсказки."} situations: {introduction: "Теперь речь не об одном человеке или предмете, а о нескольких. Измени всю группу." promptLead: "Представь ситуацию и скажи целое предложение." introduce: "Теперь речь о нескольких таких участниках или предметах. Как назвать всю группу?" retrieve: "Представь ситуацию и скажи целое предложение самостоятельно." feedback: "Сравни, что хотел сказать, с эталоном и проследи изменения в предложении." review: "Оцени, удалось ли вспомнить ответ самостоятельно; следующую ситуацию реши заново."}} styleContent: {nativeParallel: [{native: "Мои коллеги. Мои книги." target: "Moi koledzy. Moje książki." note: "В русском множественное число прилагательного/местоимения одно для всех родов и групп («мои» и там, и там); в польском мужская личная группа (koledzy) получает особую форму (moi), отличную от остальных существительных (moje książki)." matches: false}] examples: ["Moi bracia." "Moje siostry."] why: "Главная сложность множественного числа в польском — категория «мужская личная группа» (люди мужского пола), у которой особые формы прилагательных, местоимений и глаголов; в русском такого разделения во множественном числе нет."}}
