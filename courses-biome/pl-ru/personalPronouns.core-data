}
PRONOUN {
  id: my
  forms: {nom: my gen: nas dat: nam acc: nas inst: nami loc: nas voc: my}
}
PRONOUN {
  id: wy
  forms: {nom: wy gen: was dat: wam acc: was inst: wami loc: was voc: wy}
}
PRONOUN {
  id: oni
  forms: {nom: oni gen: ich dat: im acc: ich inst: nimi loc: nich voc: oni}
