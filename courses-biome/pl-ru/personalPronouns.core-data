PRONOUN {
  id: ja
  forms: {nom: ja gen: mnie dat: mi acc: mnie inst: "mną" loc: mnie voc: ja}
}
PRONOUN {
  id: ty
  forms: {
    nom: ty
    gen: ciebie
    dat: ci
    acc: ciebie
    inst: "tobą"
    loc: tobie
    voc: ty
  }
}
PRONOUN {
  id: on
  forms: {nom: on gen: go dat: mu acc: go inst: nim loc: nim voc: on}
}
