# pl-course/reference — source SHA-256: 7255e8c686ceee17...
SURFACE course_reference
REFERENCE {pronounTeaching: {personal: {title: "Личные местоимения в конструкциях" intro: {react: "Вместо отдельной формы запоминай её место в предложении. После предлогов у местоимений третьего лица появляется n-." compact: "После предлогов у местоимений третьего лица появляется n-."} footer: {react: "Здесь обычные безударные формы. Для ударения или противопоставления: mnie, tobie, jego, jemu. После предлога: do niego, do niej, do nich, dla mnie, dla ciebie." web: "Здесь обычные безударные формы. После предлога: do niego, do niej, do nich, dla mnie, dla ciebie." native: "После предлога: do niego, do niej, do nich, dla mnie, dla ciebie."} pronounIds: ["ja" "ty" "on" "ona" "ono" "my" "wy" "oni" "one"]} contexts: [{id: "gen" caseId: "gen" cue: {full: "Nie widzę…" compact: "Nie widzę…" ios: "Nie widzę"} caseName: "Dopełniacz"} {id: "dat" caseId: "dat" cue: {full: "Daję prezent…" compact: "Daję prezent…" ios: "Daję prezent"} caseName: "Celownik"} {id: "acc" caseId: "acc" cue: {full: "Widzę…" compact: "Widzę…" ios: "Widzę"} caseName: "Biernik"} {id: "inst" caseId: "inst" cue: {full: "Idę z…" compact: "Idę z…" ios: "Idę"} caseName: "Narzędnik" valuePrefix: "z " specialValues: {ja: "ze mną"}} {id: "loc" caseId: "loc" cue: {full: "Mówię o…" compact: "Mówię o…" ios: "Mówię o"} caseName: "Miejscownik" valuePrefix: "o "}] possessive: {title: "Владелец меняется независимо от падежа" demo: {nounId: "wife" adjectiveId: "beautiful" number: "sg" cases: [{id: "nom" caption: {web: "Mianownik" desktop: "Mianownik" ios: "Mianownik"}} {id: "acc" caption: {web: "Widzę… · Biernik" desktop: "Biernik" ios: "Biernik"}} {id: "gen" caption: {web: "Nie widzę… · Dopełniacz" desktop: "Dopełniacz" ios: "Dopełniacz"}}] invariableOwnerIds: ["his" "her" "their"] rule: {invariable: "Владелец не склоняется" variable: "Согласуется с żona"}}}} verbTeaching: {subjects: [{id: "ja" person: 1 number: "sg" genderMode: "selected" label: {full: "ja — я" compact: "ja — я"}} {id: "ty" person: 2 number: "sg" genderMode: "selected" label: {full: "ty — ты" compact: "ty — ты"}} {id: "on" person: 3 number: "sg" genderMode: "fixed" fixedGender: "m-personal" label: {full: "on — он" compact: "on — он"}} {id: "ona" person: 3 number: "sg" genderMode: "fixed" fixedGender: "f" label: {full: "ona — она" compact: "ona — она"}} {id: "ono" person: 3 number: "sg" genderMode: "fixed" fixedGender: "n" label: {full: "ono — оно" compact: "ono — оно"}} {id: "my" person: 1 number: "pl" genderMode: "selected" label: {full: "my — мы" compact: "my — мы"}} {id: "wy" person: 2 number: "pl" genderMode: "selected" label: {full: "wy — вы" compact: "wy — вы"}} {id: "oni" person: 3 number: "pl" genderMode: "fixed" fixedGender: "m-personal" label: {full: "oni — мужская личная группа" compact: "oni — мужская группа"}} {id: "one" person: 3 number: "pl" genderMode: "fixed" fixedGender: "f" label: {full: "one — остальные" compact: "one — остальные"}}] genderControlLabel: {full: "Род для ja / ty / my / wy" compact: "Род"} genderOptions: [{id: "m" label: {full: "Мужской / мужская личная группа" compact: "Мужской"}} {id: "f" label: {full: "Женский / женская группа" compact: "Женский"}}] tenseLabels: {present: {full: "Teraz · сейчас" compact: "Teraz"} past: {full: "Przeszłość · прошлое" compact: "Przeszłość"} future: {full: "Przyszłość · будущее" compact: "Przyszłość"}} futureExplanation: {react: "Составное будущее: będę + инфинитив (będę robić) или форма на -ł с родом и числом (będę robił / robiła). У być: będę, без второго глагола." compact: "Составное будущее: będę + инфинитив или форма на -ł. У być: będę, без второго глагола."}} caseTeaching: {caseNote: {react: "Wołacz показан как форма обращения; с неодушевлёнными словами обычно используется только стилистически. «Zachwycam się…» = «Восхищаюсь…» (Narzędnik), «Przyglądam się…» — Celownik." compact: "Wołacz — форма обращения. «Zachwycam się…» требует Narzędnik; «Przyglądam się…» — Celownik."} comparisonReadingHint: "Читай по строке, чтобы сравнить типы. По столбцу — чтобы увидеть все формы одного слова."} comparisonNounIds: ["husband" "friendM" "dog" "house" "wife" "book" "child"] russianSupport: {title: {full: "Опора на русский: что переносится, а что проверить" compact: "Опора на русский"} columns: ["Русская опора" "Польская конструкция" "Проверка"] rows: [{id: "accusative" cue: "вижу кого? что?" react: {construction: "Widzę moją żonę." check: "Логика винительного знакома; польские окончания нужно менять во всей группе."} web: {construction: "Widzę moją żonę." check: "Польские окончания меняются во всей группе."} desktop: {construction: "Widzę moją żonę." check: "Окончания меняются во всей группе"} mobileLine: "вижу кого? что? → Widzę moją żonę. Окончания меняются во всей группе." comparisons: [{from: "moja żona" to: "moją żonę" beforeParts: [{text: "moj" isChanged: false isEnding: false} {text: "a" isChanged: true isEnding: true} {text: " " isChanged: false isEnding: false} {text: "żon" isChanged: false isEnding: false} {text: "a" isChanged: true isEnding: true}] afterParts: [{text: "moj" isChanged: false isEnding: false} {text: "ą" isChanged: true isEnding: true} {text: " " isChanged: false isEnding: false} {text: "żon" isChanged: false isEnding: false} {text: "ę" isChanged: true isEnding: true}]}]} {id: "instrumental" cue: "с моей женой" react: {construction: "z moją żoną" check: "Польское женское -ą соответствует здесь творительному; это же окончание есть у прилагательного в Bierniku."} web: {construction: "z moją żoną" check: "Женское -ą здесь соответствует творительному."} desktop: {construction: "z moją żoną" check: "Женское -ą — творительный"} mobileLine: "с моей женой → z moją żoną. Женское -ą — творительный." comparisons: [{from: "moja żona" to: "moją żoną" beforeParts: [{text: "moj" isChanged: false isEnding: false} {text: "a" isChanged: true isEnding: true} {text: " " isChanged: false isEnding: false} {text: "żon" isChanged: false isEnding: false} {text: "a" isChanged: true isEnding: true}] afterParts: [{text: "moj" isChanged: false isEnding: false} {text: "ą" isChanged: true isEnding: true} {text: " " isChanged: false isEnding: false} {text: "żon" isChanged: false isEnding: false} {text: "ą" isChanged: true isEnding: true}]}]} {id: "locative" cue: "говорю о жене" react: {construction: "mówię o żonie" check: "Местный падеж требует предлога; żona → żonie."} web: {construction: "mówię o żonie" check: "Местный падеж требует предлога; żona → żonie."} desktop: {construction: "mówię o żonie" check: "Местный требует предлога"} mobileLine: "говорю о жене → mówię o żonie. Местный требует предлога." comparisons: [{from: "żona" to: "żonie" beforeParts: [{text: "żon" isChanged: false isEnding: false} {text: "a" isChanged: true isEnding: true}] afterParts: [{text: "żon" isChanged: false isEnding: false} {text: "ie" isChanged: true isEnding: true}]}]} {id: "possessive" cue: "мой / его / их" react: {construction: "moją żonę / jego żonę / ich żonę" check: "jego, jej, ich не склоняются. Формы mojego и mojej зависят от предмета обладания."} web: {construction: "moją żonę / jego żonę / ich żonę" check: "jego, jej, ich не склоняются."} desktop: {construction: "moją / jego / ich żonę" check: "jego, jej, ich не склоняются"} mobileLine: "мой / его / их → moją / jego / ich żonę. jego, jej, ich не склоняются." comparisons: [{from: "moją żonę" to: "jego żonę" beforeParts: [{text: "moją" isChanged: true isEnding: false} {text: " żonę" isChanged: false isEnding: false}] afterParts: [{text: "jego" isChanged: true isEnding: false} {text: " żonę" isChanged: false isEnding: false}]} {from: "moją żonę" to: "ich żonę" beforeParts: [{text: "moją" isChanged: true isEnding: false} {text: " żonę" isChanged: false isEnding: false}] afterParts: [{text: "ich" isChanged: true isEnding: false} {text: " żonę" isChanged: false isEnding: false}]}]}]} pipeline: {title: "Сначала конструкция, затем формы" steps: [{id: "intent" label: "01 · Смысл" question: "Что хочу сказать?" example: "Вижу / не вижу / говорю о…"} {id: "case" label: "02 · Операция" question: "Какой падеж нужен?" example: "widzę → Biernik"} {id: "agreement" label: "03 · Согласование" question: "Меняю всю группу" example: "moją + piękną + żonę"}] compactExample: "widzę → Biernik → moją + piękną + żonę"} systemCards: [{id: "noun" title: "Существительное" explanation: "Род × число × падеж" example: "żona → żonę → żony" steps: ["żona" "żonę" "żony"]} {id: "agreement" title: "Прилагательное и владелец" explanation: "Копируют род, число и падеж" example: "moja piękna → moją piękną" steps: ["moja piękna" "moją piękną"]} {id: "verb" title: "Глагол" explanation: "Лицо × число × время × вид" example: "widzę → widziałem → będę widzieć" steps: ["widzę" "widziałem" "będę widzieć"]} {id: "modifiers" title: "Модификаторы" explanation: "Отрицание · вопрос · владелец" example: "Widzę… → Nie widzę… → Czy widzę…?" steps: ["Widzę…" "Nie widzę…" "Czy widzę…?"]}] maleAccRows: [{id: "person" label: "Человек" title: "mąż / kolega" examples: [{from: "mój dobry mąż" to: "mojego dobrego męża" sentence: "Widzę mojego dobrego męża."} {from: "mój dobry kolega" to: "mojego dobrego kolegę" sentence: "Widzę mojego dobrego kolegę."}] rule: "На согласную: как Gen. На -a: -ę у существительного, но -ego у местоимения и прилагательного."} {id: "animal" label: "Животное" title: "pies / kot" examples: [{from: "mój dobry pies" to: "mojego dobrego psa" sentence: "Widzę mojego dobrego psa."}] rule: "Винительный как родительный: pies → psa."} {id: "object" label: "Предмет" title: "dom / samochód" examples: [{from: "mój nowy samochód" to: "mój nowy samochód" sentence: "Widzę mój nowy samochód."}] rule: "Винительный как именительный: группа сохраняет базовую форму."}] aspectRows: [{label: "robić · процесс" from: "robić" present: "robię" past: "robiłem / robiłam" future: "będę robić"} {label: "zrobić · результат" from: "zrobić" present: null past: "zrobiłem / zrobiłam" future: "zrobię"} {label: "kupować · процесс" from: "kupować" present: "kupuję" past: "kupowałem / kupowałam" future: "będę kupować"} {label: "kupić · результат" from: "kupić" present: null past: "kupiłem / kupiłam" future: "kupię"}] tenseRows: [{label: "Сейчас" from: "Moja piękna żona idzie do domu." to: "Moja piękna żona idzie do domu."} {label: "Прошедшее" from: "Moja piękna żona idzie do domu." to: "Moja piękna żona szła do domu."} {label: "Будущее · процесс" from: "Moja piękna żona szła do domu." to: "Moja piękna żona będzie szła do domu."} {label: "Отрицание" from: "Moja piękna żona idzie do domu." to: "Moja piękna żona nie idzie do domu."} {label: "Вопрос" from: "Moja piękna żona idzie do domu." to: "Czy moja piękna żona idzie do domu?"}] chainRows: [{label: "База" from: "To jest moja piękna żona." to: "Widzę moją piękną żonę." change: "Biernik всей группы"} {label: "Прошедшее" from: "Widzę moją piękną żonę." to: "Widziałem moją piękną żonę." change: "widzę → widziałem"} {label: "Отрицание" from: "Widziałem moją piękną żonę." to: "Nie widziałem mojej pięknej żony." change: "вся группа: Biernik → Dopełniacz"} {label: "Их вместо моей" from: "Nie widziałem mojej pięknej żony." to: "Nie widziałem ich pięknej żony." change: "mojej → ich; ich не склоняется"} {label: "Говорю о…" from: "Nie widziałem ich pięknej żony." to: "Mówię o ich pięknej żonie." change: "o → Miejscownik"}] caseRows: [{id: "nom" pl: "Mianownik" ru: "Именительный" question: "kto? co?" trigger: "To jest…"} {id: "gen" pl: "Dopełniacz" ru: "Родительный" question: "kogo? czego?" trigger: "nie widzę / nie mam / bez / do" skill: "case.gen.neg"} {id: "dat" pl: "Celownik" ru: "Дательный" question: "komu? czemu?" trigger: "daję / pomagam" skill: "case.dat"} {id: "acc" pl: "Biernik" ru: "Винительный" question: "kogo? co?" trigger: "widzę / mam / lubię" skill: "case.acc.f"} {id: "inst" pl: "Narzędnik" ru: "Творительный" question: "kim? czym?" trigger: "z (с) / jestem" skill: "case.inst"} {id: "loc" pl: "Miejscownik" ru: "Предложный" question: "o kim? o czym?" trigger: "o / w / na (место)" skill: "case.loc"} {id: "voc" pl: "Wołacz" ru: "Обращение" question: "обращаемся к кому-то" trigger: "Żono! Kolego!"}] genderNames: {m-personal: "мужской · человек" m-animate: "мужской · животное" m-inanimate: "мужской · предмет" f: "женский" n: "средний"} matrixIntroduction: "Один небольшой словарь. Видно, что меняется при каждой операции." contextHelp: {react: "Красным показана старая часть, золотым — новая. Местоимение и прилагательное согласуются с существительным." compact: "Местоимение и прилагательное согласуются с существительным. jego, jej, ich не изменяются."} maleAccIntro: "Для единственного числа сначала определи тип существительного." aspectNoPresent: {compact: "Нет настоящего времени" ios: "Настоящее: нет настоящего времени"} webCaseCompositionHeader: "Местоимение + прилагательное + существительное"}
