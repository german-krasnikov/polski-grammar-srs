# courses/lang/en/exercise-recipes.json — source SHA-256: 05757efb0e6966df...
# $comment_chain: generateChain's 5 fixed steps (UniversalCorePlan.md §5.1/§5.3), recast in en's own grammar rather than pl's case walk: role (Subj->Obj) -> tense (Pres->Past) -> negation (do-support) -> possessive owner swap (my->her) -> role again (Obj->In). Each step's own verb/negation form is baked directly into its own pattern key's copy text ("seenObj"/"chainPast"/"chainNeg"), exactly like pl's "seenAcc"/"chainPast" — only the noun phrase is realized live through ConstructionRealizer, matching pl's chain design precisely (pl's own chain never realizes its verb through core.verb.tense either). en has no grammatical gender, so firstSkillByGender carries only "default".
CHAIN {
  source: {
    kind: prefixed
    spec: {
      construction: core.argument.case-role
      bundle: [{feature: Number value: sg} {feature: Case value: Subj}]
    }
    prefixCase: Subj
    punct: "."
  }
  expected: {
    kind: pattern
    key: seenObj
    values: [
      {
        name: obj
        value: {
          kind: phrase
          spec: {
            construction: core.argument.case-role
            bundle: [{feature: Number value: sg} {feature: Case value: Obj}]
          }
        }
      }
    ]
  }
  promptKey: chainObjPrompt
  explanationKey: chainObjReason
  changes: [
    {
      from: {
        kind: phrase
        spec: {
          construction: core.argument.case-role
          bundle: [{feature: Number value: sg} {feature: Case value: Subj}]
        }
      }
      to: {
        kind: phrase
        spec: {
          construction: core.argument.case-role
          bundle: [{feature: Number value: sg} {feature: Case value: Obj}]
        }
      }
      reason: {kind: fixed key: chainObjReason}
    }
  ]
  tags: [obj]
  ownerOut: my
}
