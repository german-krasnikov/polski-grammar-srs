PREPOSITION {
  id: role
  forms: [
    {role: Subj form: ""}
    {role: Obj form: ""}
    {role: In form: in}
    {role: With form: with}
    {role: To form: to}
    {role: About form: about}
    {role: Of form: of}
  ]
}
