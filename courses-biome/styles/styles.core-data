# courses/styles/minimal-theory.json — source SHA-256: 3dc89ab8a1549bd3...
# courses/styles/native-contrast.json — source SHA-256: e62dd012c32f470b...
# courses/styles/rule-first.json — source SHA-256: 2b34a01937f8e80f...
# courses/styles/situation-first.json — source SHA-256: f29d62285b123576...
STYLE {
  id: minimal-theory
  label: {ru: "Минимум теории" en: "Minimal theory"}
  description: {
    ru: "Только примеры; «Почему так?» — по запросу."
    en: "Examples only; \"Why?\" is available on demand."
  }
  front: [examples]
  back: [whyOnDemand changes]
}
STYLE {
  id: native-contrast
  label: {ru: "Через сравнение с родным" en: "Native contrast"}
  description: {
    ru: "По-родному так → по-изучаемому так: где совпадает, где отличается."
    en: "L1 parallel: where it matches the target language, where it differs."
  }
  front: [nativeParallel]
  back: [changes contrast]
  requires: [nativeParallel]
  fallback: rule-first
}
STYLE {
  id: rule-first
  label: {ru: "Через правило" en: "Rule first"}
  description: {
    ru: "Сначала схема и таблица окончаний, затем пример."
    en: "The scheme and the ending table come first, the example follows."
  }
  front: [table formula]
  back: [rule changes contrast]
}
STYLE {
  id: situation-first
  label: {ru: "Через ситуацию" en: "Situation first"}
  description: {
    ru: "Короткая сцена сразу, правило — после ответа."
    en: "A short scene up front, the rule follows the answer."
  }
  front: [scene]
  back: [changes rule]
}
