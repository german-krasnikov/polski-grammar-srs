PROGRAM exerciseOracle VERSION 1
TYPE CaseKind = enum(chain|skill)
TYPE Seed = record{nounId:text,adjectiveId:text}
TYPE Input = record{seed:optional<Seed>,step:optional<int>,skillId:optional<text>,preferred:optional<Seed>}
TYPE Context = record{randomDraws:list<number>,drawsUsed:int,nowIso:optional<text>}
TYPE Change = record{from:text,to:text,reason:text}
TYPE ExpectedExercise = record{id:text,primarySkill:text,source:text,prompt:text,expected:text,accepted:list<text>,explanation:text,changes:list<Change>,nounId:text,adjectiveId:text,possessive:text,number:text,tags:list<text>}
TYPE Case = record{id:text,kind:CaseKind,input:Input,context:Context,exercise:ExpectedExercise}
