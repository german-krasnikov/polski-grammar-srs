CASE {id: "E-en:role.object-B" kind: skill input: {skillId: "en:role.object" preferred: null} context: {randomDraws: [0.81 0.07 0.55] drawsUsed: 1} exercise: {id: "generated" primarySkill: "en:role.object" source: "Here is my new phone." prompt: "Скажи, что видишь названное. Начни с «I see…»." expected: "I see my new phone." explanation: "I see требует дополнения после глагола; падежа нет — форма слова не меняется, меняется только его место в предложении." changes: [{from: "my new phone" to: "my new phone" reason: "Роль меняется (подлежащее → дополнение), форма слова остаётся прежней."}] nounId: "phone" adjectiveId: "new" possessive: "my" number: "sg" tags: ["obj"] accepted: []}}
CASE {id: "E-en:verb.presentSimple-A" kind: skill input: {skillId: "en:verb.presentSimple" preferred: null} context: {randomDraws: [0.34 0.72 0.18] drawsUsed: 1} exercise: {id: "generated" primarySkill: "en:verb.presentSimple" source: "My good dog walked." prompt: "Перенеси предложение в настоящее простое время." expected: "My good dog walks." explanation: "Подлежащее не меняется; меняется только форма глагола по времени и (для he/she/it) по -s." changes: [{from: "walked" to: "walks" reason: "Меняется форма глагола, остальные слова сохраняются."}] nounId: "dog" adjectiveId: "good" possessive: "my" number: "sg" tags: ["verb" "present" "subj"] accepted: []}}
