CASE {id: "E-en:possessive.my-A" kind: skill input: {skillId: "en:possessive.my" preferred: null} context: {randomDraws: [0.34 0.72 0.18] drawsUsed: 2} exercise: {id: "generated" primarySkill: "en:possessive.my" source: "I see my good dog." prompt: "Замени «мой» на «наш / наша». Сохрани время и смысл предложения." expected: "I see our good dog." explanation: "my/your/his/her/its/our/their не согласуются ни с родом, ни с числом предмета — это закрытый список неизменяемых слов." changes: [{from: "my good dog" to: "our good dog" reason: "Меняем владельца, остальная фраза не меняется."}] nounId: "dog" adjectiveId: "good" possessive: "our" number: "sg" tags: ["agreement" "obj"] accepted: []}}
CASE {id: "E-en:possessive.my-B" kind: skill input: {skillId: "en:possessive.my" preferred: null} context: {randomDraws: [0.81 0.07 0.55] drawsUsed: 2} exercise: {id: "generated" primarySkill: "en:possessive.my" source: "I see my new phone." prompt: "Замени «мой» на «твой / твоя». Сохрани время и смысл предложения." expected: "I see your new phone." explanation: "my/your/his/her/its/our/their не согласуются ни с родом, ни с числом предмета — это закрытый список неизменяемых слов." changes: [{from: "my new phone" to: "your new phone" reason: "Меняем владельца, остальная фраза не меняется."}] nounId: "phone" adjectiveId: "new" possessive: "your" number: "sg" tags: ["agreement" "obj"] accepted: []}}
CASE {id: "E-en:mood.question-A" kind: skill input: {skillId: "en:mood.question" preferred: null} context: {randomDraws: [0.34 0.72 0.18] drawsUsed: 1} exercise: {id: "generated" primarySkill: "en:mood.question" source: "You walk." prompt: "Сделай вопрос, на который можно ответить «да» или «нет». Начни с «Do…»." expected: "Do you walk?" explanation: "Do выносится перед подлежащим; смысловой глагол остаётся в базовой форме." changes: [{from: "You walk" to: "Do you walk" reason: "Do-support: вспомогательный глагол выносится вперёд, смысловой глагол теряет -s."}] nounId: "dog" adjectiveId: "good" possessive: "my" number: "sg" tags: ["mood" "question"] accepted: []}}
