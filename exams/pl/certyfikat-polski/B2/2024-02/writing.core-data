DSL 1
WRITING_TASK {
  taskId: certyfikat-polski-B2-2024-02-write-i-a
  examRef: certyfikat-polski-B2-2024-02
  taskNumber: 1
  setId: I
  instruction: "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy. W każdym zestawie są dwa zadania: a i b. Należy wybrać tylko jeden zestaw i wykonać obydwa zadania (a i b) z danego zestawu, zgodnie z poleceniami, np.: • zestaw I – zadania a i b z zestawu I lub • zestaw II – zadania a i b z zestawu II lub • zestaw III – zadania a i b z zestawu III"
  promptText: "Proszę napisać e-mail do swojej polskiej przyjaciółki / swojego polskiego przyjaciela i opisać w nim swój nowy samochód / swój nowy sprzęt kuchenny."
  wordLimit: 120
  genre: email
}
WRITING_TASK {
  taskId: certyfikat-polski-B2-2024-02-write-i-b
  examRef: certyfikat-polski-B2-2024-02
  taskNumber: 1
  setId: I
  instruction: "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy. W każdym zestawie są dwa zadania: a i b. Należy wybrać tylko jeden zestaw i wykonać obydwa zadania (a i b) z danego zestawu, zgodnie z poleceniami, np.: • zestaw I – zadania a i b z zestawu I lub • zestaw II – zadania a i b z zestawu II lub • zestaw III – zadania a i b z zestawu III"
  promptText: "Współpracuje Pani/Pan z polską gazetą. Proszę napisać dla niej sprawozdanie z dwudniowej wystawy zoologicznej / targów zabawek i artykułów dla dzieci."
  wordLimit: 180
  genre: report
}
WRITING_TASK {
  taskId: certyfikat-polski-B2-2024-02-write-ii-a
  examRef: certyfikat-polski-B2-2024-02
