  passageRef: certyfikat-polski-B2-2022-06-read-1
  questionType: multiple_choice
  questionText: "Z tekstu dowiadujemy się, że"
  options: "a) wartość zamówienia nie będzie jedynym kryterium branym pod uwagę przez miasto.|b) większość pojazdów będzie przystosowana dla osób z niepełnosprawnością.|c) producenci powinni do końca sierpnia przekazać miastu gotowe autobusy."
  correctAnswer: "a) wartość zamówienia nie będzie jedynym kryterium branym pod uwagę przez miasto."
  pointsQuarter: 4
}
