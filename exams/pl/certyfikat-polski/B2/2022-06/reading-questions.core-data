  questionId: certyfikat-polski-B2-2022-06-r1-q3
  passageRef: certyfikat-polski-B2-2022-06-read-1
  questionType: multiple_choice
  questionText: "Z tekstu dowiadujemy się, że"
  options: "a) Poczta Polska zmieniła wysokość opłat za przesyłki polecone.|b) Poczta Polska wycofała ze swojej oferty jedną z usług.|c) decyzja Poczty Polskiej może narazić na straty część jej klientów."
  correctAnswer: "c) decyzja Poczty Polskiej może narazić na straty część jej klientów."
  pointsQuarter: 4
}
READING_QUESTION {
