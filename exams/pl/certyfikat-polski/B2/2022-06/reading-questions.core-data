  questionType: multiple_choice
  questionText: "Z tekstu dowiadujemy się, że"
  options: "a) wystawa poświęcona jest wyłącznie wizerunkom udomowionych kotów.|b) do tej pory nie było w Europie wystawy poświęconej kotom w sztuce japońskiej.|c) wystawa prezentuje wyobrażenia różnych zwierząt żyjących w XXI wieku."
  correctAnswer: "b) do tej pory nie było w Europie wystawy poświęconej kotom w sztuce japońskiej."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-B2-2022-06-r1-q2
  passageRef: certyfikat-polski-B2-2022-06-read-1
  questionType: multiple_choice
  questionText: "Z tekstu dowiadujemy się, że"
  options: "a) poszukiwania kobiety zaczęły się przed północą.|b) ratownicy GOPR zostali wezwani przez rodzinę zaginionej.|c) w odnalezieniu kobiety pomógł użyty przez nią dron."
  correctAnswer: "a) poszukiwania kobiety zaczęły się przed północą."
  pointsQuarter: 4
}
