  taskRef: certyfikat-polski-B2-2022-06-listen-1
  questionType: multiple_choice
  questionText: "Mama Ani"
  options: "a) obawia się o wyniki w nauce swojej córki.|b) uważa, że Ania spędza za dużo czasu przed ekranem.|c) martwi się, że córka nie ma wielu znajomych."
  correctAnswer: "b) uważa, że Ania spędza za dużo czasu przed ekranem."
  pointsQuarter: 4
}
