READING_QUESTION {
  questionId: certyfikat-polski-B2-2017-reading-1-1
  passageRef: certyfikat-polski-B2-2017-read-1
  questionType: multiple_choice
  questionText: "Z tego tekstu dowiadujemy się, że"
  options: "a) podczas wiatrów krótkie rejsy należy odbywać na małych jachtach.|b) człowieka poznaje się w trudnych warunkach.|c) relacje między ludźmi najlepiej badają testy i treningi psychologiczne."
  correctAnswer: "b) człowieka poznaje się w trudnych warunkach."
  pointsQuarter: 4
}
