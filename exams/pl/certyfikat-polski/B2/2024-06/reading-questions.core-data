READING_QUESTION {
  questionId: certyfikat-polski-B2-2024-06-r3-q1
  passageRef: certyfikat-polski-B2-2024-06-read-3
  questionType: gap_fill_fragment
  questionText: "Luka 1 w tekście „Czy świat bez kawy to nasza przyszłość?”"
  options: "A. sprzyjające uprawie rośliny panują na terenach górzystych|B. drugim po oleju najczęściej sprzedawanym towarem|C. w obliczu zachodzących zmian klimatu|D. promujące jeden typ genetyczny danej rośliny|E. nasiona aż 45% dzikich gatunków kawowca|F. sporej ilości światła słonecznego w ciągu dnia|G. kilkunastu gatunków warzyw i owoców|H. wahania temperatury potrafią zahamować wzrost|I. kryzysu związanego z brakiem ziaren kawowca|J. osłabione przez niedobór wody egzemplarze|K. niekorzystne warunki środowiskowe"
  correctAnswer: "G. kilkunastu gatunków warzyw i owoców"
  pointsQuarter: 4
}
