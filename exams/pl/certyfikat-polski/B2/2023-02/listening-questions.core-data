DSL 1
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l1-q1
  taskRef: certyfikat-polski-B2-2023-02-listen-1
  questionType: multiple_choice
  questionText: "Z rozmowy wynika, że mężczyzna"
  options: "a) żałuje, że kobieta nie poszła z nim na kręgle.|b) świetnie bawił się na kręgielni.|c) jest zawiedziony rekomendacją kolegi."
  correctAnswer: "c) jest zawiedziony rekomendacją kolegi."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l1-q2
  taskRef: certyfikat-polski-B2-2023-02-listen-1
  questionType: multiple_choice
  questionText: "Z dialogu wynika, że"
  options: "a) jest zmiana organizacji ruchu.|b) kobieta prowadzi samochód.|c) mężczyzna i kobieta utknęli w korku."
  correctAnswer: "a) jest zmiana organizacji ruchu."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l1-q3
  taskRef: certyfikat-polski-B2-2023-02-listen-1
  questionType: multiple_choice
  questionText: Audycja
  options: "a) poświęcona jest prezentacji poglądów różnych psychologów.|b) zawiera rady dotyczące sposobu wychowania dzieci.|c) jest polemiką Aleksandry Piotrowskiej z innymi specjalistami."
  correctAnswer: "b) zawiera rady dotyczące sposobu wychowania dzieci."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l1-q4
  taskRef: certyfikat-polski-B2-2023-02-listen-1
  questionType: multiple_choice
  questionText: "Aleksandra Piotrowska uważa, że stosowanie jakichkolwiek kar"
  options: "a) w ogóle nie powinno mieć miejsca.|b) to jedyny skuteczny sposób wpływania na zachowanie dziecka.|c) nie może być jedyną stosowaną metodą wychowawczą."
  correctAnswer: "c) nie może być jedyną stosowaną metodą wychowawczą."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l1-q5
  taskRef: certyfikat-polski-B2-2023-02-listen-1
  questionType: multiple_choice
  questionText: "Rozmowa dotyczy"
  options: "a) pomocy w opiece nad dzieckiem.|b) przeniesienia terminu wizyty lekarskiej.|c) planów rodzinnego wyjazdu do Łodzi."
  correctAnswer: "a) pomocy w opiece nad dzieckiem."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l1-q6
  taskRef: certyfikat-polski-B2-2023-02-listen-1
  questionType: multiple_choice
  questionText: "Wizyta u dentysty"
  options: "a) nie była wcześniej planowana.|b) odbędzie się przed południem.|c) zmusi matkę kobiety do zmiany planów."
  correctAnswer: "b) odbędzie się przed południem."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q1
  taskRef: certyfikat-polski-B2-2023-02-listen-2
  questionType: multiple_choice
  questionText: "Słownik polsko-polski"
  options: "a) to tytuł najnowszej publikacji profesora Miodka.|b) stracił w ostatnich latach na popularności.|c) można obejrzeć w telewizji."
  correctAnswer: "c) można obejrzeć w telewizji."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q2
  taskRef: certyfikat-polski-B2-2023-02-listen-2
  questionType: multiple_choice
  questionText: "Justyna Janus-Konarska"
  options: "a) poprosiła profesora Miodka o poradę językową.|b) od kilkunastu lat jest związana ze Słownikiem polsko-polskim.|c) występuje w telewizji u boku profesora Miodka."
  correctAnswer: "c) występuje w telewizji u boku profesora Miodka."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q3
  taskRef: certyfikat-polski-B2-2023-02-listen-2
  questionType: multiple_choice
  questionText: Janus-Konarska
  options: "a) ciągle doskonali swoje kompetencje językowe.|b) uważa, że błędy są wyrazem braku szacunku do języka.|c) zachęca wszystkich do poszerzania swojej wiedzy językowej."
  correctAnswer: "a) ciągle doskonali swoje kompetencje językowe."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q4
  taskRef: certyfikat-polski-B2-2023-02-listen-2
  questionType: multiple_choice
  questionText: "Profesor Miodek"
  options: "a) świetnie opanował wiele języków obcych.|b) w stosunku do języka nie jest wielkim tradycjonalistą.|c) uważa, że konflikt pokoleń widoczny w języku jest typowy dla polszczyzny."
  correctAnswer: "b) w stosunku do języka nie jest wielkim tradycjonalistą."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q5
  taskRef: certyfikat-polski-B2-2023-02-listen-2
  questionType: multiple_choice
  questionText: "Jan Miodek wspomina rok 1989 w kontekście"
  options: "a) konfliktów społecznych, które pojawiły się w Polsce.|b) napływu do języka polskiego słów pochodzenia angielskiego.|c) publikacji jednej ze swoich książek."
  correctAnswer: "b) napływu do języka polskiego słów pochodzenia angielskiego."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q6
  taskRef: certyfikat-polski-B2-2023-02-listen-2
  questionType: multiple_choice
  questionText: "Profesor Miodek uważa, że"
  options: "a) sposoby komunikacji zmieniają się z pokolenia na pokolenia.|b) zmiany językowe są źródłem konfliktów pomiędzy ludźmi.|c) starsze pokolenie z chęcią przyswaja młodzieżowe sformułowania."
  correctAnswer: "a) sposoby komunikacji zmieniają się z pokolenia na pokolenia."
  pointsQuarter: 4
}
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-02-l2-q7
