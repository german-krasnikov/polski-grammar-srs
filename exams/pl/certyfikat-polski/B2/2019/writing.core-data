DSL 1
# B2/2019 arkusz p. 26: choose one set and write both a and b; paper job-ad card is fully transcribed.
WRITING_TASK {
  taskId: B2-2019-writing-1a
  examRef: certyfikat-polski-B2-2019
  taskNumber: 1
  setId: I
  instruction: "Zestaw I, zadanie a. 100 słów."
  promptText: "Jest Pani zainteresowana / Pan zainteresowany poniższą ofertą pracy. Proszę napisać list motywacyjny.\n\nFundacja Zwierzęta Niczyje poszukuje opiekuna do pomocy w schronisku.\n* Masz minimum 18 lat i kochasz zwierzęta?\n* Chcesz pospacerować, ale nie masz z kim?\n* Nie chcesz siedzieć w biurze od 8.00 do 16.00?\n* A może robisz świetne zdjęcia i w ten sposób będziesz promować adopcje?\nJeśli na któreś z tych pytań odpowiedziałeś „tak”, to mamy dla Ciebie propozycję – dołącz do nas!\nCo prawda oferujemy minimalne stawki, ale w ramach premii możesz liczyć na mnóstwo miłości i wdzięczności.\nListy motywacyjne proszę kierować na adres: zwierzeta.niczyje@org.pl"
  wordLimit: 100
  genre: letter
}
WRITING_TASK {
  taskId: B2-2019-writing-1b
  examRef: certyfikat-polski-B2-2019
  taskNumber: 2
  setId: I
  instruction: "Zestaw I, zadanie b. 200 słów."
  promptText: "„Cała widownia płakała ze śmiechu”. Proszę napisać recenzję filmu lub przedstawienia teatralnego, którą zamieści Pani / Pan na polskim portalu „Propozycje na Weekend”."
  wordLimit: 200
  genre: review
}
WRITING_TASK {
  taskId: B2-2019-writing-2a
  examRef: certyfikat-polski-B2-2019
  taskNumber: 1
  setId: II
  instruction: "Zestaw II, zadanie a. 30 słów."
  promptText: "Organizuje Pani / Pan w jednym z polskich miast uroczyste otwarcie własnej cukierni. Proszę napisać zaproszenie dla swojego nauczyciela z kursu kulinarnego."
  wordLimit: 30
  genre: invitation
}
WRITING_TASK {
  taskId: B2-2019-writing-2b
  examRef: certyfikat-polski-B2-2019
  taskNumber: 2
  setId: II
  instruction: "Zestaw II, zadanie b. 270 słów."
  promptText: "„Złość jest chorobą duszy” (Eliza Orzeszkowa). Czy zgadza się Pani / Pan z tym stwierdzeniem? Proszę napisać tekst argumentacyjny (rozprawkę)."
  wordLimit: 270
  genre: argument
}
WRITING_TASK {
  taskId: B2-2019-writing-3a
  examRef: certyfikat-polski-B2-2019
  taskNumber: 1
  setId: III
  instruction: "Zestaw III, zadanie a. 100 słów."
  promptText: "Niedawno kupiła Pani / kupił Pan w Polsce mieszkanie. W imieniu lokatorów domu proszę napisać podanie do zarządcy osiedla, prosząc o budowę placu zabaw dla dzieci."
  wordLimit: 100
  genre: application
}
WRITING_TASK {
  taskId: B2-2019-writing-3b
  examRef: certyfikat-polski-B2-2019
  taskNumber: 2
  setId: III
  instruction: "Zestaw III, zadanie b. 200 słów."
  promptText: "„Gdybym mogła / Gdybym mógł cofnąć czas, to wszystko bym zmieniła / bym zmienił”. Proszę napisać opowiadanie zainspirowane powyższym zdaniem."
  wordLimit: 200
  genre: story
}
