DSL 1
WRITING_TASK {
  taskId: "B2-2019-writing-1a"
  examRef: "certyfikat-polski-B2-2019"
  taskNumber: 1
  instruction: "Zestaw I, zadanie a: Jest Pani zainteresowana / Pan zainteresowany ponisza oferta pracy. Prosze napisac list motywacyjny."
  promptText: "Fundacja Zwierzeta Niczyje poszukuje opiekuna do pomocy w schronisku. Masz minimum 18 lat i kochasz zwierzeta? Chcesz pospacerować, ale nie masz z kim? Nie chcesz siedziec w biurze od 8.00 do 16.00? Oferujemy minimalne stawki, ale w ramach premii mozesz liczyc na mnostwo miosci i wdzecznosci."
  wordLimit: 100
  genre: letter
}
WRITING_TASK {
  taskId: "B2-2019-writing-1b"
  examRef: "certyfikat-polski-B2-2019"
  taskNumber: 2
  instruction: "Zestaw I, zadanie b: 'Caa widownia pakaa ze smiechu'. Prosze napisac recenzje filmu lub przedstawienia teatralnego."
  promptText: "Caa widownia pakaa ze smiechu. Prosze napisac recenzje filmu lub przedstawienia teatralnego, ktora zamiesci Pani / Pan na polskim portalu 'Propozycje na Weekend'."
  wordLimit: 200
  genre: description
}
WRITING_TASK {
  taskId: "B2-2019-writing-2a"
  examRef: "certyfikat-polski-B2-2019"
  taskNumber: 3
  instruction: "Zestaw II, zadanie a: Organizuje Pani / Pan uroczyste otwarcie wasnej cukierni. Prosze napisac zaproszenie."
  promptText: "Organizuje Pani / Pan w jednym z polskich miast uroczyste otwarcie wasnej cukierni. Prosze napisac zaproszenie dla swojego nauczyciela z kursu kulinarnego."
  wordLimit: 30
  genre: letter
}
WRITING_TASK {
  taskId: "B2-2019-writing-2b"
  examRef: "certyfikat-polski-B2-2019"
  taskNumber: 4
  instruction: "Zestaw II, zadanie b: 'Zosc jest choroba duszy' (Eliza Orzeszkowa). Prosze napisac tekst argumentacyjny."
  promptText: "'Zosc jest choroba duszy' (Eliza Orzeszkowa). Czy zgadza sie Pani / Pan z tym stwierdzeniem? Prosze napisac tekst argumentacyjny (rozprawke)."
  wordLimit: 270
  genre: argument
}
WRITING_TASK {
  taskId: "B2-2019-writing-3a"
  examRef: "certyfikat-polski-B2-2019"
  taskNumber: 5
  instruction: "Zestaw III, zadanie a: Prosze napisac podanie do zarzadcy osiedla, proszac o budowe placu zabaw dla dzieci."
  promptText: "Niedawno kupia Pani / kupi Pan w Polsce mieszkanie. W imieniu lokatorow domu prosze napisac podanie do zarzadcy osiedla, proszac o budowe placu zabaw dla dzieci."
  wordLimit: 100
  genre: letter
}
WRITING_TASK {
  taskId: "B2-2019-writing-3b"
  examRef: "certyfikat-polski-B2-2019"
  taskNumber: 6
  instruction: "Zestaw III, zadanie b: 'Gdybym moga / Gdybym mogl cofnac czas, to wszystko bym zmienia / bym zmieni.' Prosze napisac opowiadanie."
  promptText: "'Gdybym moga / Gdybym mogl cofnac czas, to wszystko bym zmienia / bym zmieni.' Prosze napisac opowiadanie zainspirowane powyzszym zdaniem."
  wordLimit: 200
  genre: essay
