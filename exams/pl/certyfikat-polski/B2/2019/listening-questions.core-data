  taskRef: certyfikat-polski-B2-2019-listen-1
  questionType: multiple_choice
  questionText: "Kobieta żali się, że jej partner"
  options: "a) ukrywał przed nią ważne informacje.|b) nie zajmował się nią należycie.|c) zaprzeczył, że jest ojcem Julii."
  correctAnswer: "a) ukrywał przed nią ważne informacje."
  pointsQuarter: 4
}
