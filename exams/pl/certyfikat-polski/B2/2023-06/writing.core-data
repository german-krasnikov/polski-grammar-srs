DSL 1
WRITING_TASK {
  taskId: certyfikat-polski-B2-2023-06-write-i-a
  examRef: certyfikat-polski-B2-2023-06
  taskNumber: 1
  setId: I
  instruction: "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy. W każdym zestawie są dwa zadania: a i b. Należy wybrać tylko jeden zestaw i wykonać obydwa zadania (a i b) z danego zestawu, zgodnie z poleceniami, np.: • zestaw I – zadania a i b z zestawu I lub • zestaw II – zadania a i b z zestawu II lub • zestaw III – zadania a i b z zestawu III"
  promptText: "Obchodzi Pani/Pan urodziny i z tej okazji organizuje Pani/Pan imprezę w restauracji. Proszę napisać e-mail z zaproszeniem, które wyśle Pani/Pan do swojej polskiej koleżanki / swojego polskiego kolegi."
  wordLimit: 40
  genre: email
}
WRITING_TASK {
  taskId: certyfikat-polski-B2-2023-06-write-i-b
  examRef: certyfikat-polski-B2-2023-06
