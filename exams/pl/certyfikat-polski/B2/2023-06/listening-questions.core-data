  taskRef: certyfikat-polski-B2-2023-06-listen-1
  questionType: multiple_choice
  questionText: "W programie prezentowane są miejsca"
  options: "a) najchętniej odwiedzane przez turystów.|b) niespełniające oczekiwań przyjezdnych.|c) pozwalające na niskobudżetową podróż."
  correctAnswer: "b) niespełniające oczekiwań przyjezdnych."
  pointsQuarter: 4
}
