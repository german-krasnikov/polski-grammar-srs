DSL 1
LISTENING_QUESTION {
  questionId: certyfikat-polski-B2-2023-06-l1-q1
  taskRef: certyfikat-polski-B2-2023-06-listen-1
  questionType: multiple_choice
  questionText: "Reklamowany program będzie poświęcony"
  options: "a) przepisom na dania wegetariańskie.|b) miejscom, w których można kupić zdrową żywność.|c) poradom, jak nie marnować jedzenia."
  correctAnswer: "c) poradom, jak nie marnować jedzenia."
  pointsQuarter: 4
}
