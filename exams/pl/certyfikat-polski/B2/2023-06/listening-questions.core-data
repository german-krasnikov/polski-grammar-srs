  questionType: multiple_choice
  questionText: "Według rankingu główny problem z Aleją Gwiazd polega na tym, że"
  options: "a) nie oferuje dostatecznie rozwiniętej bazy noclegowej.|b) odwiedzenie jej wiąże się ze znaczącymi wydatkami.|c) nieatrakcyjnie prezentuje się w mediach społecznościowych."
  correctAnswer: "c) nieatrakcyjnie prezentuje się w mediach społecznościowych."
  pointsQuarter: 4
}
