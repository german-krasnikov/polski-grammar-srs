  questionId: certyfikat-polski-B2-2023-06-l1-q2
  taskRef: certyfikat-polski-B2-2023-06-listen-1
  questionType: multiple_choice
  questionText: "Zastosowanie się do wskazówek przekazywanych w programie pozwoli"
  options: "a) ograniczyć koszty przygotowywanych posiłków.|b) spędzać na gotowaniu mniej czasu niż dotychczas.|c) cieszyć się dłuższym życiem."
  correctAnswer: "a) ograniczyć koszty przygotowywanych posiłków."
  pointsQuarter: 4
}
