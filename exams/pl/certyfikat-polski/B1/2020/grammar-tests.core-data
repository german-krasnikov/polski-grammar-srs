DSL 1
# Arkusz B1/2020, pp. 16–20; tasks I–VIII.
GRAMMAR_TEST {
  testId: certyfikat-polski-B1-2020-grammar-1
  examRef: certyfikat-polski-B1-2020
  taskNumber: 1
  instruction: "Proszę – zgodnie z przykładami – podkreślić poprawne formy wyrazów podanych w nawiasach (odmiana rzeczowników, przymiotników i zaimków)."
}
GRAMMAR_TEST {
  testId: certyfikat-polski-B1-2020-grammar-2
