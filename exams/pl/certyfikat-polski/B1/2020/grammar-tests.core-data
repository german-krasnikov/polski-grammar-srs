  testId: certyfikat-polski-B1-2020-grammar-6
  examRef: certyfikat-polski-B1-2020
  taskNumber: 6
  instruction: "Proszę – zgodnie z przykładem – użyć wyrazu w nawiasie i przekształcić zdanie tak, by miało ten sam sens."
}
