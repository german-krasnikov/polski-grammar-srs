  taskNumber: 1
  instruction: "Podkreśl poprawne formy wyrazów w nawiasach (odmiana rzeczowników, przymiotników i zaimków). (10 × 0,5 p.)"
}
GRAMMAR_TEST {
  testId: B1-2019-grammar-2
  examRef: certyfikat-polski-B1-2019
  taskNumber: 2
  instruction: "Uzupełnij zdania wyrazami z ramki: ponieważ, jeśli, czy, żeby, którzy, że, lecz. Jeden wyraz jest niepotrzebny. (5 × 0,5 p.)"
}
