READING_PASSAGE {
  passageId: "B1-sample-reading-3"
  examRef: "certyfikat-polski-B1-sample"
  taskNumber: 3
  title: "Osobowość człowieka"
  instruction: "Proszę przeczytać tekst i zdecydować, czy stwierdzenia są prawdziwe (A), fałszywe (B) czy brakuje informacji (C)."
  text: "Charakter człowieka jest jego przeznaczeniem – uważał Heraklit z Efezu. Obecnie psychologowie zamiast o charakterze mówią częściej o osobowości. Jedna z najbardziej popularnych teorii proponuje pięć elementów: ekstrawersja, neurotyczność, ugodowość, sumienność i otwartość na doświadczenie. Typowy ekstrawertyk jest przyjazny, aktywny, towarzyski. Neurotyczność to skłonność do przeżywania negatywnych emocji. Osoby o dużej sumienności wykazują silną wolę, przy skrajnym nasileniu popadają w perfekcjonizm."
}
READING_QUESTION {
  questionId: "B1-sample-r3-q21"
  passageRef: "B1-sample-reading-3"
  questionType: true_false_not_given
  questionText: "We współczesnej psychologii termin 'charakter' jest używany rzadziej niż 'osobowość'."
  correctAnswer: "A"
  points: 2
}
