DSL 1
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q1
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Na rozpoznanie dawnej zabudowy miejskiej naprowadził"
  options: "a) równoboczny wymiar pól.|b) osobliwy odcień terenów uprawnych.|c) zachowany typ zabudowy jednorodzinnej."
  correctAnswer: "b) osobliwy odcień terenów uprawnych."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q2
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Liczbę domostw odkrytego miasta określa się za pomocą"
  options: "a) przybliżonych danych.|b) żmudnych pomiarów.|c) zmiennych wartości."
  correctAnswer: "a) przybliżonych danych."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q3
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Zagrody wiejskie skupione były wokół placu"
  options: "a) ze studnią kopaną.|b) z wysoką wieżą.|c) ze zbiornikiem wodnym."
  correctAnswer: "c) ze zbiornikiem wodnym."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q4
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Ustalanie lokalizacji znaleziska polegało na"
  options: "a) uważnym przemierzaniu terenu.|b) skanowaniu przestrzeni ze wzniesień.|c) lekturze zachowanych świadectw."
  correctAnswer: "a) uważnym przemierzaniu terenu."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q5
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Istnienie dawnej miejscowości zostało potwierdzone na podstawie"
  options: "a) badania gleby z użyciem siarki.|b) analizy składu podłoża.|c) analizy zachowanych fragmentów kości."
  correctAnswer: "b) analizy składu podłoża."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q6
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Na terenie prac archeologicznych rozpoznano"
  options: "a) fragmenty narzędzi rolniczych.|b) miejsca kultu pogańskiego.|c) pozostałości naczyń."
  correctAnswer: "c) pozostałości naczyń."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q7
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Miejsce rozpoznania archeologicznego, o którym mowa w tekście, znajduje się na terenie"
  options: "a) o pełnym zalesieniu zupełnie uniemożliwiającym badania.|b) nieużytków rolnych z dużymi skupiskami drzewostanów.|c) wykorzystywanym obecnie jako użytki rolne."
  correctAnswer: "c) wykorzystywanym obecnie jako użytki rolne."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q8
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Z tekstu wynika, że"
  options: "a) odkryte miasto było dawniej objęte prawem dziedziczenia.|b) o statusie odkrytego miasta decydowały konflikty zbrojne.|c) odkryte miasto podlegało kiedyś prawu wykupu przez wojewodów."
  correctAnswer: "a) odkryte miasto było dawniej objęte prawem dziedziczenia."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q9
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Z tekstu wynika, że odkryte miejscowości (wieś i miasto)"
  options: "a) zaopatrywały okoliczne grody w towary garncarskie.|b) leżały na szlaku handlowym.|c) pełniły funkcję spichlerza."
  correctAnswer: "b) leżały na szlaku handlowym."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q10
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Tekst zawiera informacje"
  options: "a) o ochronie tożsamości regionalnej mieszkańców Wielkopolski.|b) o sposobach i technikach pracy stosowanych w archeologii.|c) o celach i metodach prowadzenia dalszych badań archeologicznych w Wielkopolsce."
  correctAnswer: "b) o sposobach i technikach pracy stosowanych w archeologii."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r2-q1
  passageRef: certyfikat-polski-C1-2022-03-read-2
  questionType: gap_fill_fragment
  questionText: "Luka 1 w tekście „Ważne i ważniejsze”"
  options: "A. Takie właśnie pytanie zadał mi mój czternastoletni potomek.|B. Uśmiech na twarzy mi gaśnie, mina rzednie, słowa stają ością w gardle.|C. Od Ajschylosa po Shakespeare’a, od Homera po Blankę Lipińską.|D. Otworzyłem przepastną księgę, wziąłem łyk świeżego powietrza i odetchnąłem z ulgą.|E. Rodziciele stają się zatruwającymi życie figurami, a wyrocznią zostają kumple z liceum.|F. Sądzę jednak, że mówiąc, pisząc, opowiadając, wiele na świecie można zmienić.|G. Uśmiechnąłem się pod nieistniejącym wąsem, wziąłem wdech i zamierzałem odpowiedzieć.|H. Zatem opowieści to niezaprzeczalnie największy wynalazek człowieka!|I. Przypomniały mi się te wszystkie brawurowe anegdoty, bajki, opowiastki, żarty."
  correctAnswer: "E. Rodziciele stają się zatruwającymi życie figurami, a wyrocznią zostają kumple z liceum."
  pointsQuarter: 4
}
