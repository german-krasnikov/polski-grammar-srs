READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-11-r1-q1
  passageRef: certyfikat-polski-C1-2023-11-read-1
  questionType: multiple_choice
  questionText: "Program „Szansa na sukces” był"
  options: "a) pierwszym programem rozrywkowym w polskiej telewizji.|b) prekursorską produkcją polegającą na wyłanianiu talentów.|c) rodzajem mecenatu doświadczonego muzyka nad adeptem sztuki wokalnej."
  correctAnswer: "b) prekursorską produkcją polegającą na wyłanianiu talentów."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-11-r1-q2
  passageRef: certyfikat-polski-C1-2023-11-read-1
  questionType: multiple_choice
  questionText: "Dzięki wygraniu rocznego cyklu „Szansy na sukces” można"
  options: "a) nagrać piosenkę wraz ze swoim idolem.|b) poprowadzić koncert w Opolu.|c) otrzymać możliwość występu na prawdziwej estradzie."
  correctAnswer: "c) otrzymać możliwość występu na prawdziwej estradzie."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-11-r1-q3
  passageRef: certyfikat-polski-C1-2023-11-read-1
  questionType: multiple_choice
  questionText: "Kolejne muzyczne konkursy"
  options: "a) nie sprzyjają trwałemu zapamiętywaniu ich zwycięzców.|b) ugruntowują pozycję ich twórców i zapewniają sławę następnym wykonawcom.|c) sprawiają, że widzowie doświadczają poczucia przesytu i znudzenia."
  correctAnswer: "a) nie sprzyjają trwałemu zapamiętywaniu ich zwycięzców."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-11-r1-q4
  passageRef: certyfikat-polski-C1-2023-11-read-1
  questionType: multiple_choice
  questionText: "Laureaci pierwszych edycji „Idola”"
  options: "a) w krótkim czasie sięgali po kolejne trofea.|b) wkrótce rozstali się z branżą muzyczną.|c) nie zdołali szybko wybić się w branży."
  correctAnswer: "c) nie zdołali szybko wybić się w branży."
  pointsQuarter: 4
}
READING_QUESTION {
