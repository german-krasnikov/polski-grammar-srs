GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-11-g2-q1
  testRef: certyfikat-polski-C1-2023-11-grammar-2
  questionType: transform
  context: "Każdego roku obserwujemy, że eksperci w dziedzinie technologii stają się coraz bardziej potrzebni. (wzrost)"
  correctAnswer: "Każdego roku obserwujemy wzrost zapotrzebowania na ekspertów w dziedzinie technologii."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-11-g2-q2
  testRef: certyfikat-polski-C1-2023-11-grammar-2
  questionType: transform
  context: "Jedna ze znanych firm informatycznych zamierza zmienić to, że w środowisku zawodowym programistów dominują mężczyźni. (zerwać)"
  correctAnswer: "Jedna ze znanych firm informatycznych zamierza zerwać z dominacją mężczyzn w środowisku zawodowym programistów."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-11-g2-q3
  testRef: certyfikat-polski-C1-2023-11-grammar-2
  questionType: transform
  context: "Przedsiębiorstwo chce również zmienić proporcje zatrudnienia mężczyzn i kobiet, które wynoszą obecnie w Polsce 5:1. (zapowiadać)"
  correctAnswer: "Przedsiębiorstwo zapowiada również zmianę proporcji zatrudnienia mężczyzn i kobiet, wynoszącej obecnie w Polsce 5:1."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-11-g2-q4
  testRef: certyfikat-polski-C1-2023-11-grammar-2
  questionType: transform
  context: "Jego szefowie planują, że do roku 2030 udział kobiet w strukturach firmy podniesie się do 50 procent. (dążyć)"
  correctAnswer: "Jego szefowie dążą do podniesienia udziału kobiet w strukturach firmy do 50 procent do roku 2030."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-11-g2-q5
  testRef: certyfikat-polski-C1-2023-11-grammar-2
  questionType: transform
  context: "Coraz więcej firm ma nadzieję, że osiągnie równowagę zatrudnienia według płci na wszystkich typach stanowisk. (liczyć)"
  correctAnswer: "Coraz więcej firm liczy na osiągnięcie równowagi zatrudnienia według płci na wszystkich typach stanowisk."
  pointsQuarter: 4
  gradingMode: open_manual
}
