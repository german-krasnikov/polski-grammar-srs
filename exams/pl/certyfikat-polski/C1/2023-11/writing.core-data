  promptText: "Proszę napisać opowiadanie zaczynające się od słów: „Nigdy nie sądziłam / nie sądziłem, że zwykła pomyłka telefoniczna całkowicie odmieni moje życie…”."
  wordLimit: 320
  genre: story
}
