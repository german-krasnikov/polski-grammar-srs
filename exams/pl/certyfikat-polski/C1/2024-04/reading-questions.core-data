DSL 1
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q1
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "Komunistyczne mieszkania"
  options: "a) wymagały od lokatorów dużych nakładów finansowych.|b) powstawały w oparciu o wytyczne władz.|c) odznaczały się ergonomicznością."
  correctAnswer: "b) powstawały w oparciu o wytyczne władz."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q2
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "Zbiorowe pralnie"
  options: "a) nie cieszyły się popularnością wśród gospodyń domowych.|b) stały się składowiskiem zepsutego sprzętu.|c) na początku nie były w pełni wyposażone."
  correctAnswer: "c) na początku nie były w pełni wyposażone."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q3
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "Niewielkie mieszkania, które wówczas projektowano"
  options: "a) były trudne do umeblowania.|b) dawały możliwość zredukowania kosztów inwestycji.|c) pozwalały łatwo utrzymać porządek."
  correctAnswer: "b) dawały możliwość zredukowania kosztów inwestycji."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q4
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "Początkowo w czasach komunistycznych"
  options: "a) blat kuchenny służył dzieciom do zabawy.|b) stół kuchenny był jednym z podstawowych mebli.|c) rola stołu była marginalizowana."
  correctAnswer: "c) rola stołu była marginalizowana."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q5
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "W latach 60. XX wieku"
  options: "a) zaczęto wreszcie doceniać wspólne rodzinne przestrzenie.|b) pokój dzienny zwykle był nieużywanym pomieszczeniem.|c) w mieszkaniach urządzano dzieciom specjalne miejsca do nauki."
  correctAnswer: "a) zaczęto wreszcie doceniać wspólne rodzinne przestrzenie."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q6
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "Meble Kontiki"
  options: "a) zaprojektowano z myślą o polskich mieszkaniach.|b) produkowane były przez firmę z zagranicznym kapitałem.|c) trafiały do mieszkań robotników zatrudnionych przy ich produkcji."
  correctAnswer: "b) produkowane były przez firmę z zagranicznym kapitałem."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2024-04-r1-q7
  passageRef: certyfikat-polski-C1-2024-04-read-1
  questionType: multiple_choice
  questionText: "Podczas aranżowania wnętrz w czasach komunizmu Polacy"
  options: "a) nie mogli sobie pozwolić na niektóre rozwiązania ze względu na metraż pomieszczeń.|b) masowo wybierali duże sosnowe meble i jednobarwne naturalne materiały.|c) sprowadzali niektóre elementy wyposażenia z zagranicy."
  correctAnswer: "a) nie mogli sobie pozwolić na niektóre rozwiązania ze względu na metraż pomieszczeń."
  pointsQuarter: 4
}
READING_QUESTION {
