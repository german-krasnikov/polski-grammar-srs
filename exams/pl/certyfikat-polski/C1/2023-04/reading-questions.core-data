DSL 1
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q1
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Wyjątkowość nowego oprogramowania tkwi"
  options: "a) w jego nieomylności i niezawodności.|b) w dużych możliwościach przerobowych.|c) w zdolności do stawiania hipotez badawczych."
  correctAnswer: "b) w dużych możliwościach przerobowych."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q2
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Sztuczna inteligencja ułatwia ekspertom"
  options: "a) lokalizację materiału i zebranie go w jedno miejsce.|b) zapisywanie tekstów starożytnymi znakami.|c) odszyfrowanie inskrypcji rozsianych po świecie."
  correctAnswer: "c) odszyfrowanie inskrypcji rozsianych po świecie."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q3
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Grupa specjalistów w dziedzinie starożytnego pisma"
  options: "a) gromadzi się regularnie.|b) jest bardzo wąska.|c) prowadzi projekty porównawcze."
  correctAnswer: "b) jest bardzo wąska."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q4
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Niebagatelną zaletą sztucznej inteligencji jest"
  options: "a) odnajdywanie obiektów w podłożu lub w głębinach.|b) sprawność w trudnych warunkach atmosferycznych.|c) efektywność w odnajdywaniu ludzkich szczątków."
  correctAnswer: "a) odnajdywanie obiektów w podłożu lub w głębinach."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q5
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Profesor polskiej uczelni"
  options: "a) poddał rozpoznaniu terytorium kraju.|b) bada dna różnych zbiorników.|c) skanuje wybrane obszary leśne."
  correctAnswer: "a) poddał rozpoznaniu terytorium kraju."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q6
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Nowoczesne oprogramowanie pomaga odnaleźć"
  options: "a) nowe stanowiska pracy.|b) cenne paliwa kopalne.|c) porosłe florą artefakty."
  correctAnswer: "c) porosłe florą artefakty."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q7
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Archeologia cyfrowa jest lepsza od tradycyjnej, ponieważ"
  options: "a) nie naraża na szwank terenu badawczego.|b) dewastuje szatę roślinną.|c) nie wymaga podejmowania dodatkowych badań."
  correctAnswer: "a) nie naraża na szwank terenu badawczego."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q8
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Modele agentowe"
  options: "a) wyręczają archeologa w interpretacji zjawiska badawczego.|b) dokonują wyczerpujących analiz nieprzystających do siebie danych.|c) przedstawiają scenariusze domniemanych wydarzeń."
  correctAnswer: "c) przedstawiają scenariusze domniemanych wydarzeń."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q9
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Szacunki uzyskane w wyniku modelowania będą dokładniejsze, kiedy"
  options: "a) informatycy wprowadzą poprawki systemowe.|b) materiał źródłowy będzie na bieżąco uzupełniany.|c) system będzie dokonywać autokorekty danych."
  correctAnswer: "b) materiał źródłowy będzie na bieżąco uzupełniany."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r1-q10
  passageRef: certyfikat-polski-C1-2023-04-read-1
  questionType: multiple_choice
  questionText: "Polska badaczka"
  options: "a) została doceniona i wyróżniona za swoje badania.|b) otrzymała grant na badania porównawcze.|c) bada dawne metody wytwarzania trunków."
  correctAnswer: "a) została doceniona i wyróżniona za swoje badania."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r2-q1
  passageRef: certyfikat-polski-C1-2023-04-read-2
  questionType: matching
  questionText: "Dom w bąbelkach"
  options: "A. Ptaszniki często towarzyszą płazom, z niektórymi koegzystują nawet w norach. W tym symbiotycznym układzie żaby żywią się larwami pasożytującymi na ciele pajęczego gospodarza.|B. Muszle ślimaków służą krabowi do ochrony miękkiego odwłoka. Kiedy stworzenie rośnie, wprowadza się do kolejnego „domu”, uprzednio pozbywszy się właściciela.|C. Japońska wyspa Okunoshima opanowana jest przez króliki. Zwierzęta uciekły z laboratorium, w którym badano na nich działanie gazu musztardowego.|D. Natura nie lubi pustki, szczególnie jeśli chodzi o miejsce zamieszkiwania organizmów. Pomysłowość przyrody na zajmowanie najdziwaczniejszych siedlisk bywa zaskakująca.|E. Bakteria Deinococcus radiodurans potrafi przeżyć zarówno w wysokich temperaturach, jak i zamrożona w ciekłym gazie; nie straszny jest jej ani stężony kwas, ani próżnia. Wytrzymuje również promieniowanie gamma.|F. Bywa, że krab hoduje na muszli swojego ukwiała. Parzydełka gościa gwarantują gospodarzowi ochronę, a ukwiał ma zapewniony transport i możliwość zbierania pożywienia.|G. Dalecy krewni dżdżownicy, rurkoczułkowce, zamiast sterty kompostu wybierają na miejsce zamieszkania dna oceanów, a dokładniej okolice podmorskich szczelin w skorupie ziemskiej, przez które wydobywają się gorące gazy wulkaniczne.|H. Na jednej z wysp na Bahamach mieszka spore stado świń, które szukają pożywienia na łódkach turystów. Skąd się tam wzięły? Prawdopodobnie uciekły z jakiegoś wraku.|I. Krewetka i ryba zwana babką mieszkają razem w norze wykopanej przez poruszającą się po omacku krewetkę. Gdy w pobliżu siedliska pojawia się drapieżnik, babka ostrzega współlokatora za pomocą określonego ruchu ogona i oba stworzenia chowają się w jamie.|J. Bakteria Ferroplasma acidarmanus zamieszkuje podziemne żrące bajorka nasycone rozpuszczonymi metalami. Temperatura przekracza w nich 40 stopni Celsjusza.|K. Niesporczaki odkryto na szczytach Himalajów i w osadach na dnie rowów oceanicznych. Latają wokół naszej planety na granicy stratosfery i nieuszkodzone wracają do życia po 120 latach bez wody."
  correctAnswer: "G. Dalecy krewni dżdżownicy, rurkoczułkowce, zamiast sterty kompostu wybierają na miejsce zamieszkania dna oceanów, a dokładniej okolice podmorskich szczelin w skorupie ziemskiej, przez które wydobywają się gorące gazy wulkaniczne."
  pointsQuarter: 2
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2023-04-r2-q2
  passageRef: certyfikat-polski-C1-2023-04-read-2
  questionType: matching
  questionText: "Toksyczny basenik"
  options: "A. Ptaszniki często towarzyszą płazom, z niektórymi koegzystują nawet w norach. W tym symbiotycznym układzie żaby żywią się larwami pasożytującymi na ciele pajęczego gospodarza.|B. Muszle ślimaków służą krabowi do ochrony miękkiego odwłoka. Kiedy stworzenie rośnie, wprowadza się do kolejnego „domu”, uprzednio pozbywszy się właściciela.|C. Japońska wyspa Okunoshima opanowana jest przez króliki. Zwierzęta uciekły z laboratorium, w którym badano na nich działanie gazu musztardowego.|D. Natura nie lubi pustki, szczególnie jeśli chodzi o miejsce zamieszkiwania organizmów. Pomysłowość przyrody na zajmowanie najdziwaczniejszych siedlisk bywa zaskakująca.|E. Bakteria Deinococcus radiodurans potrafi przeżyć zarówno w wysokich temperaturach, jak i zamrożona w ciekłym gazie; nie straszny jest jej ani stężony kwas, ani próżnia. Wytrzymuje również promieniowanie gamma.|F. Bywa, że krab hoduje na muszli swojego ukwiała. Parzydełka gościa gwarantują gospodarzowi ochronę, a ukwiał ma zapewniony transport i możliwość zbierania pożywienia.|G. Dalecy krewni dżdżownicy, rurkoczułkowce, zamiast sterty kompostu wybierają na miejsce zamieszkania dna oceanów, a dokładniej okolice podmorskich szczelin w skorupie ziemskiej, przez które wydobywają się gorące gazy wulkaniczne.|H. Na jednej z wysp na Bahamach mieszka spore stado świń, które szukają pożywienia na łódkach turystów. Skąd się tam wzięły? Prawdopodobnie uciekły z jakiegoś wraku.|I. Krewetka i ryba zwana babką mieszkają razem w norze wykopanej przez poruszającą się po omacku krewetkę. Gdy w pobliżu siedliska pojawia się drapieżnik, babka ostrzega współlokatora za pomocą określonego ruchu ogona i oba stworzenia chowają się w jamie.|J. Bakteria Ferroplasma acidarmanus zamieszkuje podziemne żrące bajorka nasycone rozpuszczonymi metalami. Temperatura przekracza w nich 40 stopni Celsjusza.|K. Niesporczaki odkryto na szczytach Himalajów i w osadach na dnie rowów oceanicznych. Latają wokół naszej planety na granicy stratosfery i nieuszkodzone wracają do życia po 120 latach bez wody."
  correctAnswer: "J. Bakteria Ferroplasma acidarmanus zamieszkuje podziemne żrące bajorka nasycone rozpuszczonymi metalami. Temperatura przekracza w nich 40 stopni Celsjusza."
  pointsQuarter: 2
}
