{
  "name": "polski-grammar-srs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run course:validate && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:generate": "tsx tests/fixtures/kotlin-parity/generate.ts",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "course:validate": "node scripts/validate-course.mjs && node scripts/validate-vocabulary-editorial.mjs --strict && node scripts/validate-curriculum.mjs && node scripts/validate-pack-v2.mjs",
    "pack:migrate:v2": "node scripts/migrate-v1-to-v2.mjs",
    "pack:migrate:v2:check": "node scripts/migrate-v1-to-v2.mjs --check",
    "pack:validate:v2": "node scripts/validate-pack-v2.mjs",
    "vocabulary:editorial:check": "node scripts/validate-vocabulary-editorial.mjs",
    "vocabulary:editorial:strict": "node scripts/validate-vocabulary-editorial.mjs --strict",
    "lifehacks:check": "node scripts/validate-lifehacks.mjs en-ru",
    "course:inventory:check": "node scripts/inventory-course.mjs --check",
    "course:inventory:decisions:check": "node scripts/check-course-inventory.mjs --check",
    "pack:build": "node scripts/build-pack.mjs",
    "pack:build:check": "node scripts/build-pack.mjs --check",
    "pack:build:en": "node scripts/build-pack-en.mjs",
    "pack:build:en:check": "node scripts/build-pack-en.mjs --check"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.20.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
