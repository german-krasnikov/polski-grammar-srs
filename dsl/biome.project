GENERATE course-plru data --contract course --rows SkillRow {dir}/../courses-biome/pl-ru/skills.core-data --rows NounRow {dir}/../courses-biome/pl-ru/nouns.core-data --rows AdjectiveRow {dir}/../courses-biome/pl-ru/adjectives.core-data --rows VerbRow {dir}/../courses-biome/pl-ru/verbs.core-data --rows PronounRow {dir}/../courses-biome/pl-ru/personalPronouns.core-data --rows PossessiveRow {dir}/../courses-biome/pl-ru/possessives.core-data --rows SeedRow {dir}/../courses-biome/pl-ru/sentenceSeeds.core-data --rows CopyEntryRow {dir}/../courses-biome/pl-ru/exerciseCopy.core-data --rows PatternEntryRow {dir}/../courses-biome/pl-ru/exercisePatterns.core-data --rows PrefixEntryRow {dir}/../courses-biome/pl-ru/caseSentencePrefixes.core-data --rows VocabularyRow {dir}/../courses-biome/pl-ru/vocabulary.core-data --rows TrainingRow {dir}/../courses-biome/pl-ru/training.core-data --rows StemAlternationRow {dir}/../courses-biome/pl-ru/stemAlternations.core-data --rows ReferenceRow {dir}/../courses-biome/pl-ru/reference.core-data --rows MorphologyRow {dir}/../courses-biome/pl-ru/morphology.core-data --rows ConstructionRow {dir}/../courses-biome/pl-ru/constructions.core-data --rows SkillRecipeRow {dir}/../courses-biome/pl-ru/recipes.core-data --rows ChainStepRecipeRow {dir}/../courses-biome/pl-ru/chainSteps.core-data --rows RecipeDefaultsRow {dir}/../courses-biome/pl-ru/recipeDefaults.core-data --rows LifehackRow {dir}/../courses-biome/pl-ru/lifehacks.core-data --target kt --kt-package polski.data.rows.plru --out {dir}/../kotlin/shared/src/commonMain/generated/kotlin/polski/data/rows/plru/CourseRows.kt
GENERATE course-plru-frequency data --contract frequency --rows FrequencyRow {dir}/../courses-biome/pl-ru/frequency.core-data --target kt --kt-package polski.data.rows.plru.frequency --out {dir}/../kotlin/shared/src/commonMain/generated/kotlin/polski/data/rows/plru/frequency/FrequencyRows.kt
# The form table of pl-ru is derived from the lexicon rows, not authored: the rules are in derive-forms.mjs, the printed rows are checked against forms.data-contract.
GENERATE forms-plru derive {dir}/derive-forms.mjs plru OUT_PLRU {dir}/../courses-biome/pl-ru/nouns.core-data {dir}/../courses-biome/pl-ru/adjectives.core-data {dir}/../courses-biome/pl-ru/verbs.core-data {dir}/../courses-biome/pl-ru/possessives.core-data {dir}/../courses-biome/pl-ru/morphology.core-data
# The course data of en-ru (R1.14 to R1.17), the same contract in a package of its own: the pairs share the records of the skills, the exercise text and the recipes.
GENERATE course-enru data --contract course --rows EnNounRow {dir}/../courses-biome/en-ru/nouns.core-data --rows EnAdjectiveRow {dir}/../courses-biome/en-ru/adjectives.core-data --rows EnVerbRow {dir}/../courses-biome/en-ru/verbs.core-data --rows EnPronounRow {dir}/../courses-biome/en-ru/personalPronouns.core-data --rows PossessiveRow {dir}/../courses-biome/en-ru/possessives.core-data --rows EnPrepositionRow {dir}/../courses-biome/en-ru/prepositions.core-data --rows SkillRow {dir}/../courses-biome/en-ru/skills.core-data --rows EnSeedRow {dir}/../courses-biome/en-ru/sentenceSeeds.core-data --rows CopyEntryRow {dir}/../courses-biome/en-ru/exerciseCopy.core-data --rows PatternEntryRow {dir}/../courses-biome/en-ru/exercisePatterns.core-data --rows PrefixEntryRow {dir}/../courses-biome/en-ru/caseSentencePrefixes.core-data --rows VocabularyRow {dir}/../courses-biome/en-ru/vocabulary.core-data --rows TrainingRow {dir}/../courses-biome/en-ru/training.core-data --rows ConstructionRow {dir}/../courses-biome/en-ru/constructions.core-data --rows SkillRecipeRow {dir}/../courses-biome/en-ru/recipes.core-data --rows ChainStepRecipeRow {dir}/../courses-biome/en-ru/chainSteps.core-data --rows RecipeDefaultsRow {dir}/../courses-biome/en-ru/recipeDefaults.core-data --rows LifehackRow {dir}/../courses-biome/en-ru/lifehacks.core-data --target kt --kt-package polski.data.rows.enru --out {dir}/../kotlin/shared/src/commonMain/generated/kotlin/polski/data/rows/enru/CourseRows.kt
# The en-ru copies of the mappers that read records both packs share (the generated classes of the packs have one shape and two packages): the pl-ru file is the source, the English file its copy.
GENERATE enru-skill-rows derive {dir}/derive-enru-mappers.mjs copy OUT_SKILL_ROWS {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuSkillRows.kt
GENERATE enru-exercise-text-rows derive {dir}/derive-enru-mappers.mjs copy OUT_EXERCISE_TEXT_ROWS {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuExerciseTextRows.kt
GENERATE enru-vocabulary-rows derive {dir}/derive-enru-mappers.mjs copy OUT_VOCABULARY_ROWS {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuVocabularyRows.kt
GENERATE enru-skill-specs derive {dir}/derive-enru-mappers.mjs copy OUT_SKILL_SPECS {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuSkillSpecs.kt
GENERATE enru-recipe-rows derive {dir}/derive-enru-mappers.mjs copy OUT_RECIPE_ROWS {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuRecipeRows.kt
# The form table of en-ru, derived the same way (R1.16); its mapper is the copy of the pl-ru one.
GENERATE forms-enru derive {dir}/derive-forms.mjs enru OUT_ENRU {dir}/../courses-biome/en-ru/nouns.core-data {dir}/../courses-biome/en-ru/adjectives.core-data {dir}/../courses-biome/en-ru/verbs.core-data {dir}/../courses-biome/en-ru/possessives.core-data {dir}/../courses-biome/en-ru/personalPronouns.core-data {dir}/../courses-biome/en-ru/prepositions.core-data
GENERATE enru-form-tables derive {dir}/derive-enru-mappers.mjs copy OUT_FORM_TABLES {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuFormTables.kt
# The built-in presentation styles (R1.18): not a pair's data, so a contract and a package of their own.
GENERATE styles data --contract style --rows StyleRecipeRow {dir}/../courses-biome/styles/styles.core-data --target kt --kt-package polski.data.rows.styles --out {dir}/../kotlin/shared/src/commonMain/generated/kotlin/polski/data/rows/styles/StyleRows.kt
GENERATE enru-lifehack-rows derive {dir}/derive-enru-mappers.mjs copy OUT_LIFEHACK_ROWS {dir}/../kotlin/shared/src/commonMain/kotlin/polski/data/PlRuLifehackRows.kt
# The word frequencies of en-ru (R1.19): converted from courses/en-ru/frequency-top1000.json and checked, with no consumer and so no printed Kotlin (a step without --target writes nothing); the list is kept, not connected.
GENERATE course-enru-frequency data --contract frequency --rows FrequencyRow {dir}/../courses-biome/en-ru/frequency.core-data
# The course data stays in the one canonical layout of `biome fmt` (R1.19): each step checks its files and writes nothing; the fix for a file it names is `biome fmt <file>`. A new file is named here, and tests/course-data-layout.test.ts fails until it is.
GENERATE course-plru-fmt fmt {dir}/../courses-biome/pl-ru/adjectives.core-data {dir}/../courses-biome/pl-ru/caseSentencePrefixes.core-data {dir}/../courses-biome/pl-ru/chainSteps.core-data {dir}/../courses-biome/pl-ru/constructions.core-data {dir}/../courses-biome/pl-ru/exerciseCopy.core-data {dir}/../courses-biome/pl-ru/exercisePatterns.core-data {dir}/../courses-biome/pl-ru/frequency.core-data {dir}/../courses-biome/pl-ru/lifehacks.core-data {dir}/../courses-biome/pl-ru/morphology.core-data {dir}/../courses-biome/pl-ru/nouns.core-data {dir}/../courses-biome/pl-ru/personalPronouns.core-data {dir}/../courses-biome/pl-ru/possessives.core-data {dir}/../courses-biome/pl-ru/recipeDefaults.core-data {dir}/../courses-biome/pl-ru/recipes.core-data {dir}/../courses-biome/pl-ru/reference.core-data {dir}/../courses-biome/pl-ru/sentenceSeeds.core-data {dir}/../courses-biome/pl-ru/skills.core-data {dir}/../courses-biome/pl-ru/stemAlternations.core-data {dir}/../courses-biome/pl-ru/training.core-data {dir}/../courses-biome/pl-ru/verbs.core-data {dir}/../courses-biome/pl-ru/vocabulary.core-data {dir}/../courses-biome/pl-ru/uiCopy.core-data
GENERATE course-enru-fmt fmt {dir}/../courses-biome/en-ru/adjectives.core-data {dir}/../courses-biome/en-ru/caseSentencePrefixes.core-data {dir}/../courses-biome/en-ru/chainSteps.core-data {dir}/../courses-biome/en-ru/constructions.core-data {dir}/../courses-biome/en-ru/exerciseCopy.core-data {dir}/../courses-biome/en-ru/exercisePatterns.core-data {dir}/../courses-biome/en-ru/frequency.core-data {dir}/../courses-biome/en-ru/lifehacks.core-data {dir}/../courses-biome/en-ru/nouns.core-data {dir}/../courses-biome/en-ru/personalPronouns.core-data {dir}/../courses-biome/en-ru/possessives.core-data {dir}/../courses-biome/en-ru/prepositions.core-data {dir}/../courses-biome/en-ru/recipeDefaults.core-data {dir}/../courses-biome/en-ru/recipes.core-data {dir}/../courses-biome/en-ru/sentenceSeeds.core-data {dir}/../courses-biome/en-ru/skills.core-data {dir}/../courses-biome/en-ru/training.core-data {dir}/../courses-biome/en-ru/verbs.core-data {dir}/../courses-biome/en-ru/vocabulary.core-data {dir}/../courses-biome/en-ru/uiCopy.core-data
GENERATE uicopy-oracle-fmt fmt {dir}/ui-copy/uicopy-oracle.core-data
