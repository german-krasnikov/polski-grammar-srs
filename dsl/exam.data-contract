DSL 1
# Exam preparation modules: listening, reading, grammar and writing tasks for any language exam
# (Certyfikat Polski, IELTS, DELF, TestDaF, etc.). Provider and targetLanguage are open strings
# so a new exam board is added as data, not a contract edit. See Plans/Architecture/EXAM-MODULES-PLAN.md.

RECORD ExamRow KEY examId COUNT 1..
  examId: string
  provider: string
  targetLanguage: string
  level: string
  year: int OPTIONAL
  sourceUrl: string OPTIONAL
  license: string OPTIONAL
END

# A reviewed source directory becomes visible under a stable public route.
RECORD ExamPublicationRow KEY routeId COUNT 1..
  routeId: string
  examRef: ref ExamRow
  displayTitle: string
  sourceDir: string
END

# Certified written-module cover values. A timed sitting requires all four rows.
RECORD ExamModuleRow KEY moduleId COUNT 1..
  moduleId: string
  examRef: ref ExamRow
  module: enum listening|reading|grammar|writing
  order: int
  durationSeconds: int
  maximumQuarter: int
END

# Listening: one audio file per exam, each task plays a segment (startMs..endMs).
RECORD ListeningTaskRow KEY taskId COUNT 1..
  taskId: string
  examRef: ref ExamRow
  taskNumber: int
  audioUrl: string
  segmentStartMs: int
  segmentEndMs: int
  instruction: string
  transcript: string OPTIONAL
  promptImageUrl: string OPTIONAL
  promptImageAlt: string OPTIONAL
END

RECORD ListeningQuestionRow KEY questionId COUNT 1..
  questionId: string
  taskRef: ref ListeningTaskRow
  questionType: enum multiple_choice|true_false|fill_gap|match|matching
  questionText: string
  options: string OPTIONAL
  correctAnswer: string
  points: int OPTIONAL
  pointsQuarter: int OPTIONAL
  gradingMode: enum exact|open_manual OPTIONAL
  answerMode: enum single|unordered_set OPTIONAL
  creditPerCorrectQuarter: int OPTIONAL
  requiredSelections: int OPTIONAL
  setOverselectionMode: enum legacy_wrong|manual_review OPTIONAL
END

RECORD ListeningAnswerVariantRow KEY variantId COUNT 1..
  variantId: string
  questionRef: ref ListeningQuestionRow
  answer: string
  earnedQuarter: int
END

# A fact is an independently creditable answer; aliases never create new credit.
RECORD ListeningAcceptedFactRow KEY factId COUNT 0..
  factId: string
  questionRef: ref ListeningQuestionRow
  creditQuarter: int
  displayText: string
END

RECORD ListeningAcceptedFactAliasRow KEY aliasId COUNT 0..
  aliasId: string
  factRef: ref ListeningAcceptedFactRow
  answerText: string
END

# Reading: passages with questions; paragraphs derived from text by blank-line split.
RECORD ReadingPassageRow KEY passageId COUNT 1..
  passageId: string
  examRef: ref ExamRow
  taskNumber: int
  title: string OPTIONAL
  source: string OPTIONAL
  instruction: string
  text: string
END

RECORD ReadingQuestionRow KEY questionId COUNT 1..
  questionId: string
  passageRef: ref ReadingPassageRow
  questionType: enum multiple_choice|true_false_not_given|match_heading|fill_gap|short_answer|gap_fill_fragment|matching|word_bank
  questionText: string
  options: string OPTIONAL
  correctAnswer: string
  points: int OPTIONAL
  pointsQuarter: int OPTIONAL
  gradingMode: enum exact|open_manual OPTIONAL
  answerMode: enum single|unordered_set OPTIONAL
  creditPerCorrectQuarter: int OPTIONAL
  requiredSelections: int OPTIONAL
  setOverselectionMode: enum legacy_wrong|manual_review OPTIONAL
  relevantParagraph: int OPTIONAL
END

RECORD ReadingAnswerVariantRow KEY variantId COUNT 0..
  variantId: string
  questionRef: ref ReadingQuestionRow
  answer: string
  earnedQuarter: int
END

RECORD ReadingAcceptedFactRow KEY factId COUNT 0..
  factId: string
  questionRef: ref ReadingQuestionRow
  creditQuarter: int
  displayText: string
END

RECORD ReadingAcceptedFactAliasRow KEY aliasId COUNT 0..
  aliasId: string
  factRef: ref ReadingAcceptedFactRow
  answerText: string
END

# Grammar: structured tests with items of various types.
RECORD GrammarTestRow KEY testId COUNT 1..
  testId: string
  examRef: ref ExamRow
  taskNumber: int
  instruction: string
END

# One row per printed occurrence, including repeated words in a task bank.
RECORD GrammarBankTokenRow KEY tokenId COUNT 1..
  tokenId: string
  testRef: ref GrammarTestRow
  position: int
  text: string
END

RECORD GrammarItemRow KEY itemId COUNT 1..
  itemId: string
  testRef: ref GrammarTestRow
  questionType: enum choose_form|fill_gap|transform|word_formation|word_bank|question_formation
  context: string
  questionTarget: string OPTIONAL
  gap: string OPTIONAL
  options: string OPTIONAL
  correctAnswer: string
  points: int OPTIONAL
  pointsQuarter: int OPTIONAL
  gradingMode: enum exact|open_manual OPTIONAL
END

# Additional accepted answers may earn part of the item's maximum, in quarter-point units.
RECORD GrammarAnswerVariantRow KEY variantId COUNT 1..
  variantId: string
  itemRef: ref GrammarItemRow
  answer: string
  earnedQuarter: int
  onlyIfNotUsedBy: ref GrammarItemRow OPTIONAL
END

# Official review criteria; these do not authorize automatic substring scoring.
RECORD GrammarRubricComponentRow KEY componentId COUNT 0..
  componentId: string
  itemRef: ref GrammarItemRow
  order: int
  creditQuarter: int
  criterionText: string
END

# An explicitly accepted combination of two answers from one grammar test.
RECORD GrammarAnswerPairRow KEY pairId COUNT 0..
  pairId: string
  firstItemRef: ref GrammarItemRow
  firstAnswer: string
  secondItemRef: ref GrammarItemRow
  secondAnswer: string
  firstEarnedQuarter: int
  secondEarnedQuarter: int
END

# Writing: prompts with genre and optional word limit.
RECORD WritingTaskRow KEY taskId COUNT 1..
  taskId: string
  examRef: ref ExamRow
  taskNumber: int
  setId: string OPTIONAL
  instruction: string
  promptText: string
  promptImageUrl: string OPTIONAL
  promptImageAlt: string OPTIONAL
  wordLimit: int OPTIONAL
  genre: enum letter|description|argument|essay|invitation|wishes|story|report|sms|opinion|announcement|email|review|advertisement|application|speech|characterization
END

# Scoring oracle: input/output pairs for the answer-matching rule (P4: test expectations in DSL).
# Adding a case = one .core-data line; the Kotlin test loops over generated rows.
RECORD ScoringCaseRow KEY id COUNT 1..
  id: string
  answer: string
  expected: string
  correct: bool
END

RECORD QuarterScoringCaseRow KEY id COUNT 1..
  id: string
  fullAnswer: string
  partialAnswer: string
  partialQuarter: int
  maximumQuarter: int
  answer: string
  expectedQuarter: int
END

RECORD WeightedScoringCaseRow KEY id COUNT 1..
  id: string
  answer: string
  expected: string
  maximumQuarter: int
  earnedQuarter: int
END

# Published paper inventory and formatting expectations, consumed by generic Kotlin tests.
RECORD ExamInventoryCaseRow KEY id COUNT 1..
  id: string
  section: enum listening|reading|grammar
  taskRef: string
  itemCount: int
  pointsQuarter: int
  variantCount: int OPTIONAL
  segmentStartMs: int OPTIONAL
  segmentEndMs: int OPTIONAL
END

RECORD WritingPromptCaseRow KEY id COUNT 1..
  id: string
  setId: string
  taskNumber: int
  wordLimit: int
  promptImageUrl: string OPTIONAL
END

RECORD QuarterFormatCaseRow KEY id COUNT 1..
  id: string
  pointsQuarter: int
  expectedText: string
END

RECORD AnswerEvaluationCaseRow KEY id COUNT 1..
  id: string
  consumer: enum grammar|listening
  mode: enum exact|open_manual
  fullAnswer: string
  variantAnswer: string OPTIONAL
  variantQuarter: int OPTIONAL
  maximumQuarter: int
  answer: string
  expectedStatus: enum confirmed_full|confirmed_partial|wrong|pending_manual
  expectedConfirmedQuarter: int
  expectedPendingQuarter: int
END

RECORD AnswerAttemptCaseRow KEY id COUNT 1..
  id: string
  exactAnswer: string
  openAnswer: string
  exactResponse: string
  openResponse: string
  exactMaximumQuarter: int
  openMaximumQuarter: int
  expectedConfirmedQuarter: int
  expectedPendingQuarter: int
  expectedPossibleQuarter: int
  expectedFinal: bool
END

# Independently transcribed pair outcomes from the C1 April 2024 key.
RECORD GrammarPairCaseRow KEY id COUNT 0..
  id: string
  answer8: string
  answer9: string
  status8: enum confirmed_full|wrong|pending_manual
  status9: enum confirmed_full|wrong|pending_manual
  confirmed8: int
  confirmed9: int
  pending8: int
  pending9: int
END

RECORD NovemberListeningCaseRow KEY id COUNT 0..
  id: string
  answer: string
  expectedStatus: enum confirmed_full|confirmed_partial|wrong|pending_manual
  confirmedQuarter: int
  pendingQuarter: int
END

RECORD GrammarRubricCaseRow KEY id COUNT 0..
  id: string
  itemRef: string
  componentCount: int
  maximumQuarter: int
  unknownAnswer: string
  unknownPendingQuarter: int
END

RECORD UnorderedSetCaseRow KEY id COUNT 1..
  id: string
  correctAnswer: string
  options: string
  answer: string
  maximumQuarter: int
  creditPerCorrectQuarter: int OPTIONAL
  mode: enum exact|open_manual OPTIONAL
  expectedStatus: enum confirmed_full|confirmed_partial|wrong|pending_manual
  expectedConfirmedQuarter: int
  expectedPendingQuarter: int OPTIONAL
END

# Independently transcribed cover values and grouped reading keys for P11 acceptance.
RECORD ExamModuleCaseRow KEY id COUNT 1..
  id: string
  examRef: string
  module: enum listening|reading|grammar|writing
  order: int
  durationSeconds: int
  maximumQuarter: int
END

RECORD ReadingSetCaseRow KEY id COUNT 1..
  id: string
  correctAnswer: string
  options: string
  answer: string
  maximumQuarter: int
  creditPerCorrectQuarter: int
  expectedConfirmedQuarter: int
END

# Source-grounded groups whose keys explicitly accept other correct answers.
RECORD OpenItemGroupCaseRow KEY id COUNT 1..
  id: string
  section: enum grammar|listening
  groupRef: string
  expectedItemCount: int
  unknownAnswer: string
  expectedUnknownStatus: enum pending_manual
  expectedBlankStatus: enum wrong
END

# Official B2/2020 Grammar II key: II/8=w only when II/6 did not use w.
RECORD GrammarConstraintCaseRow KEY id COUNT 1..
  id: string
  answer6: string
  answer8: string
  expected6Quarter: int
  expected8Quarter: int
END

# Independent printed controls and keys for P10 (source: six local arkusz/klucz PDFs).
RECORD BankTokenCaseRow KEY id COUNT 1..
  id: string
  testId: string
  expectedOrderedTokenText: string
  expectedDuplicateCount: int
END

RECORD QuestionControlCaseRow KEY id COUNT 1..
  id: string
  sourceItemId: string
  expectedTag: string
  expectedKind: enum single_option|text|unordered_set|bank_option
  expectedOptionCount: int
  expectedRawAnswer: string
  expectedQuestionTarget: string OPTIONAL
  expectedQuarter: int
  expectedStatus: enum confirmed_full|confirmed_partial|wrong|pending_manual
END
