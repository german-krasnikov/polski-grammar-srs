TEST "C1 2024-04 official Writing set I retains Polish drafts and awaits manual assessment" PROFILE playmode
  open exam="C1 Certyfikat 2024-04" module="writing"
  ASSERT writing.setChoiceCount == 3
  selectWritingSet set="I"
  openWritingGuidance
  ASSERT writing.taskLabel == "Задание 1 / 2"
  ASSERT writing.instructionOpening == "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy."
  ASSERT writing.promptOpening == "Jest Pani organizatorką / Jest Pan organizatorem konferencji studenckiej „Wiedza kluczem do sukcesu”. Proszę napisać tekst przemówienia, które wygłosi Pani/Pan podczas rozpoczęcia obrad."
  writeDraft text="Życzę Państwu sukcesów."
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.taskLabel == "Задание 2 / 2"
  ASSERT writing.promptOpening == "Czy zgadza się Pani/Pan ze stwierdzeniem, że kult młodości to w dzisiejszych czasach przeżytek? Proszę napisać tekst argumentacyjny, w którym wyrazi Pani/Pan swoją opinię."
  writeDraft text="Łódź inspiruje mnie do pisania."
  back
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.draft == "Łódź inspiruje mnie do pisania."
  submitWriting
  ASSERT writing.reviewCount == 2
  ASSERT writing.reviewDrafts == "Życzę Państwu sukcesów.|Łódź inspiruje mnie do pisania."
  ASSERT writing.manualPoints == "0|40|40"
  ASSERT writing.autoScoreVisible == false
END
