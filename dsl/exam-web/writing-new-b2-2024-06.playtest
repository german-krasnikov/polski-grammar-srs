TEST "B2 2024-06 official Writing set I retains Polish drafts and awaits manual assessment" PROFILE playmode
  open exam="B2 Certyfikat 2024-06" module="writing"
  ASSERT writing.setChoiceCount == 3
  selectWritingSet set="I"
  openWritingGuidance
  ASSERT writing.taskLabel == "Задание 1 / 2"
  ASSERT writing.instructionOpening == "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy."
  ASSERT writing.promptOpening == "Prowadzi Pani/Pan w Polsce hotel dla zwierząt. Proszę napisać reklamę, którą zamieści Pani/Pan na portalu „Usługi na Wysokim Poziomie”."
  writeDraft text="Życzę Państwu sukcesów."
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.taskLabel == "Задание 2 / 2"
  ASSERT writing.promptOpening == "Proszę napisać opowiadanie zainspirowane poniższym zdjęciem. Proszę nadać mu tytuł."
  waitImage
  ASSERT exam.promptImageLoaded == true
  ASSERT exam.promptImageAlt == "Dwa samoloty na lotnisku; jeden stoi na trawie, drugi leci nad nim."
  writeDraft text="Łódź inspiruje mnie do pisania."
  back
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.draft == "Łódź inspiruje mnie do pisania."
  submitWriting
  ASSERT writing.reviewCount == 2
  ASSERT writing.reviewDrafts == "Życzę Państwu sukcesów.|Łódź inspiruje mnie do pisania."
  ASSERT writing.manualPoints == "0|40|40"
  ASSERT writing.autoScoreVisible == false
END
