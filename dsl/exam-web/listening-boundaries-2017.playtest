TEST "B1 2017 all five official recording windows stop at their own endings" PROFILE playmode
  open exam="B1 Certyfikat 2017" module="listening"
  ASSERT media.taskLabel == "Задание 1 / 5"
  ASSERT media.durationLabel == "4:14"
  auditSegment start=115 end=369
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 2 / 5"
  ASSERT media.durationLabel == "3:50"
  auditSegment start=369 end=599
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 3 / 5"
  ASSERT media.durationLabel == "4:38"
  auditSegment start=599 end=877
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 4 / 5"
  ASSERT media.durationLabel == "3:59"
  auditSegment start=877 end=1116
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 5 / 5"
  ASSERT media.durationLabel == "4:39"
  auditSegment start=1116 end=1395
END
