TEST "Official B1 browser catalog shows mapped modules and hides unfinished papers" PROFILE playmode
  openCatalog
  ASSERT exam.listVisible == true
  ASSERT catalog.b12019Counts == "55|35|42|6"
  ASSERT catalog.b12017Counts == "50|34|37|6"
  ASSERT catalog.b12020Visible == false
  ASSERT catalog.b22017Visible == false
  ASSERT catalog.b22020Visible == false
  open exam="B1 Certyfikat 2019" module="writing"
  ASSERT writing.setChoiceCount == 3
END
