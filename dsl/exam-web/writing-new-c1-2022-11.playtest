TEST "C1 2022-11 official Writing set I retains Polish drafts and awaits manual assessment" PROFILE playmode
  open exam="C1 Certyfikat 2022-11" module="writing"
  ASSERT writing.setChoiceCount == 3
  selectWritingSet set="I"
  openWritingGuidance
  ASSERT writing.taskLabel == "Задание 1 / 2"
  ASSERT writing.instructionOpening == "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy."
  ASSERT writing.promptOpening == "Jest Pani/Pan dyrektorem firmy motoryzacyjnej (lub firmy produkującej zdrową żywność), która w tym roku obchodzi swoje dziesięciolecie. Proszę napisać przemówienie, które wygłosi Pani/Pan na uroczystości z okazji jubileuszu."
  writeDraft text="Życzę Państwu sukcesów."
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.taskLabel == "Задание 2 / 2"
  ASSERT writing.promptOpening == "Optymiści mają łatwiejsze życie? Proszę napisać tekst argumentacyjny (rozprawkę), w którym wyrazi Pani/Pan swoją opinię."
  writeDraft text="Łódź inspiruje mnie do pisania."
  back
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.draft == "Łódź inspiruje mnie do pisania."
  submitWriting
  ASSERT writing.reviewCount == 2
  ASSERT writing.reviewDrafts == "Życzę Państwu sukcesów.|Łódź inspiruje mnie do pisania."
  ASSERT writing.manualPoints == "0|40|40"
  ASSERT writing.autoScoreVisible == false
END
