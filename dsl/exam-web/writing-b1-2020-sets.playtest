TEST "B1 2020 SMS set keeps two independent drafts" PROFILE playmode
  open exam="B1 Certyfikat 2020" module="writing"
  ASSERT writing.setChoiceCount == 3
  selectWritingSet set="I"
  ASSERT writing.taskLabel == "Задание 1 / 2"
  ASSERT writing.promptOpening == "Jest Pani zainteresowana / Pan zainteresowany tym ogłoszeniem. Proszę napisać SMS do pani Anny, zapytać o szczegóły (cena, piętro) i umówić się na spotkanie."
  writeDraft text="Dzień dobry, proszę o cenę."
  nextWriting
  ASSERT writing.taskLabel == "Задание 2 / 2"
  ASSERT writing.draft == ""
  writeDraft text="Relacja z podróży."
  changeWritingSet
  selectWritingSet set="II"
  ASSERT writing.draft == ""
  changeWritingSet
  selectWritingSet set="I"
  ASSERT writing.draft == "Dzień dobry, proszę o cenę."
  nextWriting
  ASSERT writing.draft == "Relacja z podróży."
  submitWriting
  ASSERT writing.reviewCount == 2
  ASSERT writing.reviewDrafts == "Dzień dobry, proszę o cenę.|Relacja z podróży."
  ASSERT writing.autoScoreVisible == false
END
