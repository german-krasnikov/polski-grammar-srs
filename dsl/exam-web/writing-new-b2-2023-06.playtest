TEST "B2 2023-06 official Writing set I retains Polish drafts and awaits manual assessment" PROFILE playmode
  open exam="B2 Certyfikat 2023-06" module="writing"
  ASSERT writing.setChoiceCount == 3
  selectWritingSet set="I"
  openWritingGuidance
  ASSERT writing.taskLabel == "Задание 1 / 2"
  ASSERT writing.instructionOpening == "INSTRUKCJA WYKONANIA ZADAŃ W tej części egzaminu znajdują się trzy zestawy."
  ASSERT writing.promptOpening == "Obchodzi Pani/Pan urodziny i z tej okazji organizuje Pani/Pan imprezę w restauracji. Proszę napisać e-mail z zaproszeniem, które wyśle Pani/Pan do swojej polskiej koleżanki / swojego polskiego kolegi."
  writeDraft text="Życzę Państwu sukcesów."
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.taskLabel == "Задание 2 / 2"
  ASSERT writing.promptOpening == "„Czy pieniądze są najważniejszym czynnikiem motywującym w pracy?”. Proszę napisać tekst argumentacyjny (rozprawkę), w którym wyrazi Pani/Pan swoją opinię."
  writeDraft text="Łódź inspiruje mnie do pisania."
  back
  ASSERT writing.draft == "Życzę Państwu sukcesów."
  nextWriting
  ASSERT writing.draft == "Łódź inspiruje mnie do pisania."
  submitWriting
  ASSERT writing.reviewCount == 2
  ASSERT writing.reviewDrafts == "Życzę Państwu sukcesów.|Łódź inspiruje mnie do pisania."
  ASSERT writing.manualPoints == "0|40|40"
  ASSERT writing.autoScoreVisible == false
END
