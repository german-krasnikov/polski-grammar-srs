TEST "B1 2019 all five audited recording windows stop at their own endings" PROFILE playmode
  open exam="B1 Certyfikat 2019" module="listening"
  ASSERT media.taskLabel == "Задание 1 / 5"
  ASSERT media.durationLabel == "3:26"
  auditSegment start=103 end=309
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 2 / 5"
  ASSERT media.durationLabel == "3:56"
  auditSegment start=310 end=546
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 3 / 5"
  ASSERT media.durationLabel == "4:11"
  auditSegment start=547 end=798
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 4 / 5"
  ASSERT media.durationLabel == "4:29"
  auditSegment start=799 end=1068
  advanceTask count=1
  ASSERT media.taskLabel == "Задание 5 / 5"
  ASSERT media.durationLabel == "6:46"
  auditSegment start=1069 end=1475
END
