DSL 1
# B1/2020 Listening IV B: paper p6 specifies seven 1-point answer slots;
# key p3 gives B={1,4}. Each correct selected position earns 4 quarter units.
UNORDERED_SET_CASE {
  id: b1-2020-forward
  correctAnswer: "1|4"
  options: "1|2|3|4"
  answer: "1|4"
  maximumQuarter: 8
  creditPerCorrectQuarter: 4
  expectedStatus: confirmed_full
  expectedConfirmedQuarter: 8
}
