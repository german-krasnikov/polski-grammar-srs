DSL 1
# Independent API cases. B2/C1 forms model the source shape; P9 paper drafts remain unpublished.
SET_FACT_CASE {
  id: b2-any-two-forward
  requiredSelections: 2
  maximumQuarter: 4
  answer: "są duże|są jasne"
  mode: open_manual
  expectedStatus: confirmed_full
  expectedConfirmedQuarter: 4
  expectedPendingQuarter: 0
}
