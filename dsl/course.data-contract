DSL 1
# The skills of a course pack (courses-biome/<pair>/skills.core-data), one SKILL row each: the Skill, its presentation, its style content and its SkillSpec.
# Every Row record has the suffix so its Kotlin class cannot meet polski.model.Skill in the iOS/macOS export.
# level and prerequisites are written once and are both the Skill's and the SkillSpec's. The construction is a core structure (core.composite, core.sentence.mood),
# not always one the pack has a realization for, so it is a text and not a reference to ConstructionRow.
RECORD SkillRow KEY id COUNT 1..
  id: string
  title: string
  group: string
  level: enum A1|A2|B1|B2
  formula: string
  theory: string
  hint: string
  prerequisites: [ref SkillRow]
  focus: FocusRow
  methods: MethodsRow
  construction: string
  featureFocus: FeatureFocusRow NULLABLE
  fixed: [FeatureValueRow]
  lexicalFilter: LexicalFilterRow NULLABLE
  styleContent: StyleContentRow OPTIONAL
  caseReferenceAvailable: bool OPTIONAL
END

RECORD FocusRow
  before: string
  after: string
END

RECORD MethodsRow
  logic: MethodRow
  situations: MethodRow
END

RECORD MethodRow
  introduction: string
  promptLead: string
  introduce: string
  retrieve: string
  feedback: string
  review: string
END

# The axis a skill drills (null: no single feature flip), the axes it holds fixed, and the candidates it draws from: each property of `where` names
# the values a candidate must have; a nounId is the id of a noun of pl-ru, an enNounId of en-ru (a reference has one target record, and the two packs' nouns are different records).
# The features are an open catalog, so a set of them is a list of pairs, not a record.
RECORD FeatureFocusRow
  feature: string
  from: string
  to: string
END

RECORD FeatureValueRow
  feature: string
  value: string
END

RECORD LexicalFilterRow
  slot: string
  where: WhereRow
END

RECORD WhereRow
  nounId: [ref NounRow] OPTIONAL
  enNounId: [ref EnNounRow] OPTIONAL
  gender: [string] OPTIONAL
END

# rule, examples and nativeParallel may be left out: the style composer then derives the block from the skill itself (SkillStyleContent).
RECORD StyleContentRow
  rule: string OPTIONAL
  nativeParallel: [NativeParallelRow] OPTIONAL
  examples: [string] OPTIONAL
  why: string OPTIONAL
END

RECORD NativeParallelRow
  native: string
  target: string
  note: string
  matches: bool
END

# The lexicon: nouns (the seven cases in both numbers), adjectives (all five genders in both numbers) and verbs (present in both numbers, the past stem).
# The ids of the model stay as they are (gender "m-personal"). A key of a record is an identifier, so the genders are written m_personal.. and the persons p1..p3 (R1Design.md D4).
RECORD NounRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  gender: string
  forms: NounFormsRow
END

RECORD NounFormsRow
  sg: CaseFormsRow
  pl: CaseFormsRow
END

RECORD CaseFormsRow
  nom: string
  gen: string
  dat: string
  acc: string
  inst: string
  loc: string
  voc: string
END

RECORD AdjectiveRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  forms: AdjectiveFormsRow
END

RECORD AdjectiveFormsRow
  sg: GenderFormsRow
  pl: GenderFormsRow
END

RECORD GenderFormsRow
  m_personal: CaseFormsRow
  m_animate: CaseFormsRow
  m_inanimate: CaseFormsRow
  f: CaseFormsRow
  n: CaseFormsRow
END

RECORD VerbRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  aspect: enum imperfective|perfective
  futureType: enum compound|present
  perfectivePair: ref VerbRow OPTIONAL
  present: PresentRow
  pastStem: PastStemRow
END

RECORD PresentRow
  sg: PersonFormsRow
  pl: PersonFormsRow
END

RECORD PersonFormsRow
  p1: string
  p2: string
  p3: string
END

RECORD PastStemRow
  m: string
  f: string
  n: string
  mp: string
  np: string
END

# The personal pronouns (one row each, the seven cases) and the possessives. A possessive is declined (singular by gender, plural for the
# masculine personal group and for all the rest) or invariable (one text): the contract cannot say "one or the other", so kind says which
# of value and sg+pl is written, and PlRuPronounRows.kt refuses any other combination.
RECORD PronounRow KEY id COUNT 1..
  id: string
  forms: CaseFormsRow
END

RECORD PossessiveRow KEY id COUNT 1..
  id: string
  label: string
  forms: PossessiveFormsRow
END

RECORD PossessiveFormsRow
  kind: enum declined|invariant
  value: string OPTIONAL
  sg: GenderFormsRow OPTIONAL
  pl: PossessivePluralRow OPTIONAL
END

RECORD PossessivePluralRow
  m_personal: CaseFormsRow
  other: CaseFormsRow
END

# The text of the exercises. A seed says which adjective goes with which noun. The copy (prompts, explanations), the sentence patterns and the
# prefixes of the case sentences are dictionaries of a pack: one row per key, so a repeated key is DATA_DUPLICATE and a later slice can name a
# copy key by reference. The set of keys is the pack's own (the engine asks for them by name), so a misspelt key is the engine's to refuse.
RECORD SeedRow COUNT 1..
  nounId: ref NounRow
  adjectiveId: ref AdjectiveRow
END

RECORD CopyEntryRow KEY key COUNT 1..
  key: string
  value: string
END

RECORD UiCopyRow KEY key COUNT 1..
  key: string
  text: string
END

RECORD UiCopyCaseRow KEY key COUNT 1..
  key: string
  plRu: string
  enRu: string
  placeholders: string
END

RECORD PatternEntryRow KEY key COUNT 1..
  key: string
  value: string
END

RECORD PrefixEntryRow KEY key COUNT 1..
  key: string
  value: string
END

# The vocabulary cards (one row: the cards and the texts around them), the chain of the training and the stem alternations.
# A card with no frequency rank writes null: absence is stated, not left out (NULLABLE). The ids of the cards and of the chain steps are unique,
# which the contract cannot see inside a list, so PlRuVocabularyRows.kt checks them.
RECORD VocabularyRow COUNT 1
  source: string
  items: [VocabularyItemRow]
  instructions: VocabularyInstructionsRow
  unavailableLabel: string
END

RECORD VocabularyItemRow
  id: string
  lemma: string
  translation: string
  form: string
  example: string
  level: string
  frequencyRank: int NULLABLE
END

RECORD VocabularyInstructionsRow
  react: string
  web: string
  native: string
  ios: string
END

RECORD TrainingRow COUNT 1
  chainPresentation: ChainPresentationRow
END

RECORD ChainPresentationRow
  steps: [ChainStepRow]
  completion: ChainCompletionRow
END

RECORD ChainStepRow
  id: string
  label: string
END

RECORD ChainCompletionRow
  title: string
  reactEyebrow: string
  reactBody: string
  webBody: string
END

# A stem alternation is two letters: one UTF-16 unit each.
RECORD StemAlternationRow COUNT 1..
  a: string
  b: string
END

# The reference content of the matrix screens, one row: the texts, the case table, the tables of the chain, the tenses, the aspects and the
# accusative of the masculine, the system cards and the pipeline, and the teaching texts. The reference records are named Ref... so no class meets
# a domain class of the same name in the export.
RECORD ReferenceRow COUNT 1
  matrixIntroduction: string
  webCaseCompositionHeader: string
  maleAccIntro: string
  comparisonNounIds: [ref NounRow]
  contextHelp: ReactCompactRow
  aspectNoPresent: AspectNoPresentRow
  genderNames: GenderNamesRow
  caseRows: [RefCaseRow]
  chainRows: [RefChainRow]
  tenseRows: [RefTenseRow]
  aspectRows: [RefAspectRow]
  maleAccRows: [RefMaleAccRow]
  systemCards: [RefSystemCardRow]
  pipeline: RefPipelineRow
  caseTeaching: CaseTeachingRow
  verbTeaching: VerbTeachingRow
  pronounTeaching: PronounTeachingRow
  russianSupport: RussianSupportSectionRow
END

# Two wordings of one text: the full React screen and the compact hosts (also the teaching texts of R1.10).
RECORD ReactCompactRow
  react: string
  compact: string
END

RECORD AspectNoPresentRow
  compact: string
  ios: string
END

RECORD GenderNamesRow
  m_personal: string
  m_animate: string
  m_inanimate: string
  f: string
  n: string
END

RECORD RefCaseRow
  id: string
  pl: string
  ru: string
  question: string
  trigger: string
  skill: ref SkillRow OPTIONAL
END

RECORD RefChainRow
  label: string
  from: string
  to: string
  change: string
END

RECORD RefTenseRow
  label: string
  from: string
  to: string
END

RECORD RefAspectRow
  label: string
  from: string
  present: string NULLABLE
  past: string
  future: string
END

RECORD RefMaleAccRow
  id: string
  label: string
  title: string
  examples: [RefMaleAccExampleRow]
  rule: string
END

RECORD RefMaleAccExampleRow
  from: string
  to: string
  sentence: string
END

RECORD RefSystemCardRow
  id: string
  title: string
  explanation: string
  example: string
  steps: [string]
END

RECORD RefPipelineRow
  title: string
  steps: [RefPipelineStepRow]
  compactExample: string
END

RECORD RefPipelineStepRow
  id: string
  label: string
  question: string
  example: string
END

# The teaching texts of the case table and of the verb table, and the auxiliary of the future. A verb subject is selected (the learner picks the
# gender) or fixed (it has one): the contract cannot say "fixedGender exactly when fixed", so PlRuTeachingRows.kt does.
RECORD FullCompactRow
  full: string
  compact: string
END

RECORD CaseTeachingRow
  caseNote: ReactCompactRow
  comparisonReadingHint: string
END

RECORD VerbTeachingRow
  subjects: [VerbSubjectRow]
  genderControlLabel: FullCompactRow
  genderOptions: [VerbGenderOptionRow]
  tenseLabels: TenseLabelsRow
  futureExplanation: ReactCompactRow
END

RECORD VerbSubjectRow
  id: string
  person: int
  number: string
  genderMode: enum selected|fixed
  fixedGender: string OPTIONAL
  label: FullCompactRow
END

RECORD VerbGenderOptionRow
  id: string
  label: FullCompactRow
END

RECORD TenseLabelsRow
  present: FullCompactRow
  past: FullCompactRow
  future: FullCompactRow
END

RECORD MorphologyRow COUNT 1
  futureAuxiliary: FutureAuxiliaryRow
END

RECORD FutureAuxiliaryRow
  verbId: ref VerbRow
  forms: PresentRow
END

# The teaching of the personal pronouns and the possessives, and the Russian support table. The pronoun ids are the ids of the pronoun rows and
# the possessive ids those of the possessive rows: they are references, so an id that is no row is DATA_REF. The special values of a context
# are pairs (the open dictionary of R1Design.md D4, here keyed by pronoun id).
RECORD PronounTeachingRow
  personal: PersonalTeachingRow
  contexts: [PronounContextRow]
  possessive: PossessiveTeachingRow
END

RECORD PersonalTeachingRow
  title: string
  intro: ReactCompactRow
  footer: FooterRow
  pronounIds: [ref PronounRow]
END

RECORD FooterRow
  react: string
  web: string
  native: string
END

RECORD PronounContextRow
  id: string
  caseId: string
  cue: CueRow
  caseName: string
  valuePrefix: string OPTIONAL
  specialValues: [SpecialValueRow] OPTIONAL
END

RECORD CueRow
  full: string
  compact: string
  ios: string
END

RECORD SpecialValueRow
  pronounId: ref PronounRow
  value: string
END

RECORD PossessiveTeachingRow
  title: string
  demo: PossessiveDemoRow
END

RECORD PossessiveDemoRow
  nounId: ref NounRow
  adjectiveId: ref AdjectiveRow
  number: string
  cases: [DemoCaseRow]
  invariableOwnerIds: [ref PossessiveRow]
  rule: DemoRuleRow
END

RECORD DemoCaseRow
  id: string
  caption: CaptionRow
END

RECORD CaptionRow
  web: string
  desktop: string
  ios: string
END

RECORD DemoRuleRow
  invariable: string
  variable: string
END

RECORD RussianSupportSectionRow
  title: FullCompactRow
  columns: [string]
  rows: [SupportRow]
END

RECORD SupportRow
  id: string
  cue: string
  react: ConstructionCheckRow
  web: ConstructionCheckRow
  desktop: ConstructionCheckRow
  mobileLine: string
  comparisons: [ContrastRow]
END

RECORD ConstructionCheckRow
  construction: string
  check: string
END

RECORD ContrastRow
  from: string
  to: string
  beforeParts: [EndingPartRow]
  afterParts: [EndingPartRow]
END

RECORD EndingPartRow
  text: string
  isChanged: bool
  isEnding: bool
END

# Recipe expressions (R1.11): how the text of an exercise is built from the pack. The contract has no union, so each variant is one record with a kind and
# OPTIONAL fields; PlRuRecipeRows.kt refuses a kind that lacks a field of its own or carries one of another kind. A text is a copy entry, a literal (it may be
# empty), a phrase of a construction, or a personal pronoun chosen by the gender of the noun ("default" is the pair for every other gender); `capitalized`
# puts the first letter in capitals. The names of a bundle's features are an open catalog, as in SkillRow.fixed.
RECORD TextValueRow
  kind: enum copy|literal|phrase|pronoun
  capitalized: bool OPTIONAL
  key: ref CopyEntryRow OPTIONAL
  value: string OPTIONAL
  spec: PhraseSpecRow OPTIONAL
  genderToKey: [GenderPronounRow] OPTIONAL
  caseId: string OPTIONAL
END

RECORD PhraseSpecRow
  construction: ref ConstructionRow
  bundle: [FeatureValueRow]
  ownerLexeme: ref PossessiveRow OPTIONAL
END

RECORD GenderPronounRow
  gender: string
  pronounId: string
END

# A text made of values: one of them, a pattern with a value for each placeholder, the values joined without a separator, or the case sentence of a phrase
# (the lead-in of prefixCase, the phrase, then punct).
RECORD TextSpecRow
  kind: enum direct|pattern|concat|prefixed
  value: TextValueRow OPTIONAL
  key: ref PatternEntryRow OPTIONAL
  values: [PatternValueRow] OPTIONAL
  parts: [TextValueRow] OPTIONAL
  spec: PhraseSpecRow OPTIONAL
  prefixCase: string OPTIONAL
  punct: string OPTIONAL
END

RECORD PatternValueRow
  name: string
  value: TextValueRow
END

# What changed between two texts and why: the reason is one copy entry, or picked by the first matching rule of a list (a rule with no conditions set is the unconditional fallback, and must come last).
RECORD ChangeSpecRow
  from: TextValueRow
  to: TextValueRow
  reason: ReasonSpecRow
END

RECORD ReasonSpecRow
  kind: enum fixed|classified
  key: ref CopyEntryRow OPTIONAL
  rules: [ReasonRuleRow] OPTIONAL
END

# First rule whose conditions all hold (a condition left unset always holds) wins; same "first condition that holds wins" convention as GovWhenRow/OrderWhenRow.
RECORD ReasonRuleRow
  whenUnchanged: bool OPTIONAL
  whenGender: string OPTIONAL
  whenNomSingularSuffix: string OPTIONAL
  key: ref CopyEntryRow
END

# The recipes of a pack (R1.11b): for each skill how its exercise is built (a constructed one, or a static one that is fully authored), the five steps of the
# chain, and the pack's defaults. A constructed recipe writes source, expected, explanationKey, changes and tags, and a prompt (a key, or an owner draw);
# a static one writes only staticOverride: the contract has no union, so PlRuRecipeRows.kt refuses any other combination. A recipe is one row of the skill
# it names (the mapper refuses a second one for the same skill). The owners are possessive ids; the ids of the noun and the adjective of a static exercise are
# texts, because the other pack has its own noun and adjective records. The chain's first step has no skill: it is the first skill of the noun's gender.
# A constructed recipe may also name tileTargetSlots (SB-5): the slot names of expected's own construction that a sentence-builder UI may turn into a
# picker tile; absent (the default for every existing recipe) means that skill has no sentence-builder tiles. A static recipe never writes it.
RECORD SkillRecipeRow COUNT 1..
  skill: ref SkillRow
  source: TextSpecRow OPTIONAL
  expected: TextSpecRow OPTIONAL
  promptKey: ref CopyEntryRow OPTIONAL
  explanationKey: ref CopyEntryRow OPTIONAL
  changes: [ChangeSpecRow] OPTIONAL
  accepted: [TextSpecRow] OPTIONAL
  tags: [string] OPTIONAL
  includeNounGenderTag: bool OPTIONAL
  ownerDraw: OwnerDrawRow OPTIONAL
  numberOverride: string OPTIONAL
  staticOverride: StaticExerciseRow OPTIONAL
  staticPool: [StaticExerciseRow] OPTIONAL
  tileTargetSlots: [string] OPTIONAL
END

# The second draw of a skill: one owner out of these, with the copy entry that names it in the prompt (the prompt is prefix, name, suffix).
RECORD OwnerDrawRow
  owners: [OwnerChoiceRow]
  promptPrefixKey: ref CopyEntryRow
  promptSuffixKey: ref CopyEntryRow
END

RECORD OwnerChoiceRow
  lexeme: ref PossessiveRow
  labelKey: ref CopyEntryRow
END

RECORD StaticExerciseRow
  sourceKey: ref CopyEntryRow
  promptKey: ref CopyEntryRow
  expectedKey: ref CopyEntryRow
  explanationKey: ref CopyEntryRow
  acceptedKeys: [ref CopyEntryRow]
  changeFromKey: ref CopyEntryRow
  changeToKey: ref CopyEntryRow
  changeReasonKey: ref CopyEntryRow
  nounId: string
  adjectiveId: string
  tags: [string]
END

RECORD ChainStepRecipeRow COUNT 1..
  skill: ref SkillRow OPTIONAL
  source: TextSpecRow
  expected: TextSpecRow
  promptKey: ref CopyEntryRow
  explanationKey: ref CopyEntryRow
  changes: [ChangeSpecRow]
  tags: [string]
  ownerOut: ref PossessiveRow
END

# The defaults of a pack: the unmarked owner, the verb the tense skills drill, the first skill of the chain for each gender of the noun ("default" for the
# others), and the lexical slots that are the same in every exercise, each always or only when a feature of the phrase has one of the values.
RECORD RecipeDefaultsRow COUNT 1
  defaultOwnerLexeme: ref PossessiveRow
  verbLexeme: string
  firstSkillByGender: [GenderSkillRow]
  constantSlots: [ConstantSlotRow] OPTIONAL
END

RECORD GenderSkillRow
  gender: string
  skill: ref SkillRow
END

RECORD ConstantSlotRow
  slot: string
  lexeme: string
  whenFeature: string OPTIONAL
  whenValues: [string] OPTIONAL
END

# The realization of the constructions (R1.11b): the slots of a construction in order, which lexeme category and features each needs, and when the order or the
# case governed by the construction changes. A condition is a feature and a value, written `Feature=value` by the engine. The first condition that holds wins,
# so the lists keep their order.
RECORD ConstructionRow KEY id COUNT 1..
  id: string
  slots: [SlotRow]
  govFeature: string OPTIONAL
  govDefault: string OPTIONAL
  govWhen: [GovWhenRow] OPTIONAL
  orderWhen: [OrderWhenRow] OPTIONAL
END

RECORD SlotRow
  name: string
  category: string
  optional: bool OPTIONAL
  requiredFeatures: [string]
  requiredFeaturesWhen: [RequiredWhenRow] OPTIONAL
  agreementSource: string OPTIONAL
END

RECORD ConditionRow
  feature: string
  value: string
END

RECORD GovWhenRow
  condition: ConditionRow
  result: string
END

RECORD OrderWhenRow
  condition: ConditionRow
  slots: [SlotRow]
END

RECORD RequiredWhenRow
  condition: ConditionRow
  features: [string]
END

# The English lexicon (R1.14a). English has no case and no gender, so it has records of its own: a noun has two forms, an adjective one, a verb the few forms
# of its paradigm (present3sg and past are all most verbs write; `be` has more, and `will` only its one form), a personal pronoun a subject and an object form.
# The prepositions of a role are pairs: the roles are the language's own open list. The possessives are PossessiveRow, shaped alike in both packs.
RECORD EnNounRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  forms: EnNounFormsRow
END

RECORD EnNounFormsRow
  sg: string
  pl: string
END

RECORD EnAdjectiveRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  forms: EnAdjectiveFormsRow
END

RECORD EnAdjectiveFormsRow
  invariant: string
END

RECORD EnVerbRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  present3sg: string
  presentSg1: string OPTIONAL
  presentPl: string OPTIONAL
  past: string OPTIONAL
  pastPl: string OPTIONAL
  pastParticiple: string OPTIONAL
  ing: string OPTIONAL
END

RECORD EnPronounRow KEY id COUNT 1..
  id: string
  forms: EnPronounFormsRow
END

RECORD EnPronounFormsRow
  Subj: string
  Obj: string
END

RECORD EnPrepositionRow KEY id COUNT 1..
  id: string
  forms: [RoleFormRow]
END

RECORD RoleFormRow
  role: string
  form: string
END

# A sentence seed of en-ru: which adjective goes with which noun (the nouns and adjectives of English are records of their own).
RECORD EnSeedRow COUNT 1..
  nounId: ref EnNounRow
  adjectiveId: ref EnAdjectiveRow
END

# A lifehack (R1.18): a pair-scoped tip about a trap the learner's own language sets (ADR-15), one row for each tip, in the file of its pair (courses-biome/<pair>/lifehacks.core-data).
# `skillId` is the skill the tip is shown on; a tip for no single skill leaves it out and names a `topic` instead (the mapper refuses a row with neither, and one with both). `source` says why the
# tip is trusted, never invented (ADR-15). The old JSON carried vote counts, always 0 and read by nothing: a `votes` field is DATA_UNKNOWN_FIELD now.
RECORD LifehackRow KEY id COUNT 1..
  id: string
  skillId: ref SkillRow OPTIONAL
  topic: string OPTIONAL
  text: string
  source: LifehackSourceRow
  status: enum editorial|community
END

RECORD LifehackSourceRow
  kind: enum research|teaching_practice|project_authored
  citation: string
  url: string OPTIONAL
END
