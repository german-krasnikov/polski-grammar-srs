DSL 1
# The skills of a course pack (courses-biome/<pair>/skills.core-data), one SKILL row each: the Skill, its presentation, its style content and its SkillSpec.
# Every Row record has the suffix so its Kotlin class cannot meet polski.model.Skill in the iOS/macOS export.
# level and prerequisites are written once and are both the Skill's and the SkillSpec's.
RECORD SkillRow KEY id COUNT 1..
  id: string
  title: string
  group: string
  level: enum A1|A2|B1|B2
  formula: string
  theory: string
  hint: string
  prerequisites: [ref SkillRow]
  focus: FocusRow
  methods: MethodsRow
  construction: string
  featureFocus: FeatureFocusRow NULLABLE
  fixed: [FixedRow]
  lexicalFilter: LexicalFilterRow NULLABLE
  styleContent: StyleContentRow OPTIONAL
END

RECORD FocusRow
  before: string
  after: string
END

RECORD MethodsRow
  logic: MethodRow
  situations: MethodRow
END

RECORD MethodRow
  introduction: string
  promptLead: string
  introduce: string
  retrieve: string
  feedback: string
  review: string
END

# The axis a skill drills (null: no single feature flip), the axes it holds fixed (the features are an open catalog, so pairs, not fields),
# and the candidates it draws from: each property of `where` names the values a candidate must have; a nounId is the id of a noun.
RECORD FeatureFocusRow
  feature: string
  from: string
  to: string
END

RECORD FixedRow
  feature: string
  value: string
END

RECORD LexicalFilterRow
  slot: string
  where: WhereRow
END

RECORD WhereRow
  nounId: [ref NounRow] OPTIONAL
  gender: [string] OPTIONAL
END

# rule, examples and nativeParallel may be left out: the style composer then derives the block from the skill itself (SkillStyleContent).
RECORD StyleContentRow
  rule: string OPTIONAL
  nativeParallel: [NativeParallelRow] OPTIONAL
  examples: [string] OPTIONAL
  why: string OPTIONAL
END

RECORD NativeParallelRow
  native: string
  target: string
  note: string
  matches: bool
END

# The lexicon: nouns (the seven cases in both numbers), adjectives (all five genders in both numbers) and verbs (present in both numbers, the past stem).
# The ids of the model stay as they are (gender "m-personal"). A key of a record is an identifier, so the genders are written m_personal.. and the persons p1..p3 (R1Design.md D4).
RECORD NounRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  gender: string
  forms: NounFormsRow
END

RECORD NounFormsRow
  sg: CaseFormsRow
  pl: CaseFormsRow
END

RECORD CaseFormsRow
  nom: string
  gen: string
  dat: string
  acc: string
  inst: string
  loc: string
  voc: string
END

RECORD AdjectiveRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  forms: AdjectiveFormsRow
END

RECORD AdjectiveFormsRow
  sg: GenderFormsRow
  pl: GenderFormsRow
END

RECORD GenderFormsRow
  m_personal: CaseFormsRow
  m_animate: CaseFormsRow
  m_inanimate: CaseFormsRow
  f: CaseFormsRow
  n: CaseFormsRow
END

RECORD VerbRow KEY id COUNT 1..
  id: string
  lemma: string
  meaning: string
  aspect: enum imperfective|perfective
  futureType: enum compound|present
  perfectivePair: ref VerbRow OPTIONAL
  present: PresentRow
  pastStem: PastStemRow
END

RECORD PresentRow
  sg: PersonFormsRow
  pl: PersonFormsRow
END

RECORD PersonFormsRow
  p1: string
  p2: string
  p3: string
END

RECORD PastStemRow
  m: string
  f: string
  n: string
  mp: string
  np: string
END
