GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-04-g2-q1
  testRef: certyfikat-polski-C1-2023-04-grammar-2
  questionType: transform
  context: "Nie wszyscy mieszkańcy Polski rozumieją, że zmiany w Arktyce wpłyną bezpośrednio na warunki życia w naszym kraju. (być świadomym)"
  correctAnswer: "Nie wszyscy mieszkańcy Polski są świadomi bezpośredniego wpływu zmian w Arktyce na warunki życia w naszym kraju."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-04-g2-q2
  testRef: certyfikat-polski-C1-2023-04-grammar-2
  questionType: transform
  context: "Gwałtowny wzrost temperatury Oceanu Arktycznego spowoduje, że uwolnią się złoża metanu zgromadzone w wiecznej zmarzlinie. (wywołać)"
  correctAnswer: "Gwałtowny wzrost temperatury Oceanu Arktycznego wywoła uwolnienie się złóż metanu zgromadzonych w wiecznej zmarzlinie."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-04-g2-q3
  testRef: certyfikat-polski-C1-2023-04-grammar-2
  questionType: transform
  context: "Brak mokrych wiatrów zachodnich przy silnych prądach południowych i północnych przyczyni się do tego, że w Polsce będą występować długotrwałe susze. (sprzyjać)"
  correctAnswer: "Brak mokrych wiatrów zachodnich przy silnych prądach południowych i północnych będzie sprzyjać występowaniu w Polsce długotrwałych suszy."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-04-g2-q4
  testRef: certyfikat-polski-C1-2023-04-grammar-2
  questionType: transform
  context: "W Polsce już teraz ledwo wystarcza wody, która jest potrzebna, aby chłodzić turbiny w elektrowniach. (niezbędny)"
  correctAnswer: "W Polsce już teraz ledwo wystarcza wody niezbędnej do chłodzenia turbin w elektrowniach."
  pointsQuarter: 4
  gradingMode: open_manual
}
GRAMMAR_ITEM {
  itemId: certyfikat-polski-C1-2023-04-g2-q5
  testRef: certyfikat-polski-C1-2023-04-grammar-2
  questionType: transform
  context: "Ze względu na niedobór wody powinniśmy być przygotowani na to, że prąd często będzie wyłączany. (spodziewać się)"
  correctAnswer: "Ze względu na niedobór wody powinniśmy spodziewać się częstych wyłączeń prądu."
  pointsQuarter: 4
  gradingMode: open_manual
}
