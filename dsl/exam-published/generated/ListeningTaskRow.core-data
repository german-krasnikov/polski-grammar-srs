  taskNumber: 4
  audioUrl: exam-audio/B1-2019.mp3
  segmentStartMs: 799000
  segmentEndMs: 1068000
  instruction: "Posłuchaj rad o rozmowach biznesowych. Dopasuj osobę 1–4 do opinii A–E; jedna osoba może wypowiadać więcej niż jedną opinię. Nagranie zostanie odtworzone dwa razy. (5 × 1 p.)"
}
LISTENING_TASK {
  taskId: B1-2019-listen-5
  examRef: certyfikat-polski-B1-2019
  taskNumber: 5
  audioUrl: exam-audio/B1-2019.mp3
  segmentStartMs: 1069000
  segmentEndMs: 1475000
  instruction: "Posłuchaj tekstów o organizacji przeprowadzki i dopasuj numer tekstu 1–10 do ilustracji B–K. Ilustracja A jest przykładem. Nagranie zostanie odtworzone dwa razy. (10 × 0,5 p.)"
  promptImageUrl: exam-images/B1-2019-listening-V.jpeg
  promptImageAlt: "Ilustracje A–K do zadania V: A narzędzia jako przykład; B marker, C kosmetyczka, D ciężarówka, E pudła, F ubrania na wieszakach, G wspólny posiłek, H koce, I środki czystości, J osoba niosąca pudła, K pomoc przyjaciół."
}
