  questionText: "Istnienie dawnej miejscowości zostało potwierdzone na podstawie"
  options: "a) badania gleby z użyciem siarki.|b) analizy składu podłoża.|c) analizy zachowanych fragmentów kości."
  correctAnswer: "b) analizy składu podłoża."
  pointsQuarter: 4
}
READING_QUESTION {
  questionId: certyfikat-polski-C1-2022-03-r1-q6
  passageRef: certyfikat-polski-C1-2022-03-read-1
  questionType: multiple_choice
  questionText: "Na terenie prac archeologicznych rozpoznano"
