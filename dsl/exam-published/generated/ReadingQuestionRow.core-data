  questionType: multiple_choice
  questionText: "Miejsce rozpoznania archeologicznego, o którym mowa w tekście, znajduje się na terenie"
  options: "a) o pełnym zalesieniu zupełnie uniemożliwiającym badania.|b) nieużytków rolnych z dużymi skupiskami drzewostanów.|c) wykorzystywanym obecnie jako użytki rolne."
  correctAnswer: "c) wykorzystywanym obecnie jako użytki rolne."
  pointsQuarter: 4
}
READING_QUESTION {
