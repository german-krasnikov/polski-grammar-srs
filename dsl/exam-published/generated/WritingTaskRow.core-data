}
WRITING_TASK {
  taskId: B1-2017-writing-III-1
  examRef: certyfikat-polski-B1-2017
  taskNumber: 1
  setId: III
  instruction: "Zestaw III, zadanie a"
  promptText: "Proszę opisać najpiękniejszy prezent, który dostała Pani / dostał Pan na urodziny lub imieniny."
  wordLimit: 60
  genre: description
}
WRITING_TASK {
  taskId: B1-2017-writing-III-2
  examRef: certyfikat-polski-B1-2017
  taskNumber: 2
  setId: III
  instruction: "Zestaw III, zadanie b"
  promptText: "Proszę napisać sprawozdanie (relację) z wycieczki lub podróży."
