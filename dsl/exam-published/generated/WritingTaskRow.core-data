}
WRITING_TASK {
  taskId: B1-2017-writing-II-2
  examRef: certyfikat-polski-B1-2017
  taskNumber: 2
  setId: II
  instruction: "Zestaw II, zadanie b"
  promptText: "Proszę napisać opowiadanie pt. „Jesteśmy razem już trzy lata…”. Proszę wykorzystać zdjęcie."
  promptImageUrl: exam-images/B1-2017-writing-II-2.jpeg
  promptImageAlt: "Mężczyzna siedzi nad wodą i głaszcze psa."
