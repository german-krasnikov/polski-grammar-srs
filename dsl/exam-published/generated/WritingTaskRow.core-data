DSL 1
WRITING_TASK {
  taskId: B1-2017-writing-I-1
  examRef: certyfikat-polski-B1-2017
  taskNumber: 1
  setId: I
  instruction: "Zestaw I, zadanie a"
  promptText: "Proszę napisać zaproszenie dla nauczyciela lub szefa na swoje urodziny / imieniny, które organizuje Pani / Pan w restauracji."
  wordLimit: 20
  genre: invitation
}
WRITING_TASK {
  taskId: B1-2017-writing-I-2
  examRef: certyfikat-polski-B1-2017
  taskNumber: 2
  setId: I
  instruction: "Zestaw I, zadanie b"
  promptText: "„Wakacje w domu…”. Proszę napisać wypracowanie (esej szkolny)."
  wordLimit: 180
  genre: essay
}
WRITING_TASK {
  taskId: B1-2017-writing-II-1
  examRef: certyfikat-polski-B1-2017
  taskNumber: 1
  setId: II
  instruction: "Zestaw II, zadanie a"
  promptText: "Proszę napisać życzenia dla przyjaciół z okazji ich ślubu."
